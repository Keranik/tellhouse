@page
@model HomeNode.Pages.ConnectionsModel
@{
    ViewData["Title"] = "Connections";
}

<h1>Connections</h1>
<p>Who is connected to this house, through which assistant, at what level. An invite grants nothing by itself; the named inviter confirms every join.</p>
<p>This page is the house side of the door. It opens only to whoever presents the house secret, and a waiting request's check phrase is shown only to them. The house side is the part of this page only the house can use.</p>

@if (Model.Note is not null)
{
    <p>@Model.Note</p>
}
@if (Model.HouseSideOpen && Model.NewInviteCode is not null)
{
    <p>New invite code (shown once, share it with the person joining): <code>@Model.NewInviteCode</code></p>
}

@if (!Model.HouseSideOpen)
{
    <div class="panel">
    <h2>The house side is closed</h2>
    <p>Present the house secret to use the house side of this page. Without it, this page only shows who is connected; it confirms nothing, declines nothing, revokes nothing, and shows no check phrases.</p>
    <form method="get">
        <label>House secret
            <input type="password" name="houseSecret" />
        </label>
        <button type="submit">Open the house side</button>
    </form>
    </div>
}
else
{
    <div class="panel">
    <h2>Invite someone</h2>
    <form method="post" asp-page-handler="Invite">
        <input type="hidden" name="houseSecret" value="@Model.PresentedHouseSecret" />
        <label>Inviter
            <select name="inviterPersonId">
                @foreach (var person in Model.People)
                {
                    <option value="@person.Id">@person.DisplayName</option>
                }
            </select>
        </label>
        <label>Intended person
            <select name="intendedPersonId">
                @foreach (var person in Model.People)
                {
                    <option value="@person.Id">@person.DisplayName</option>
                }
            </select>
        </label>
        <label>Level
            <select name="level">
                <option value="Standard">Standard</option>
                <option value="KnockOnly">Knock only</option>
            </select>
        </label>
        <button type="submit">Create invite</button>
    </form>
    </div>
}

<h2>Waiting at the door</h2>
@if (Model.PendingRequests.Count == 0)
{
    <p>Nobody is waiting. Doing nothing means no.</p>
}
@foreach (var request in Model.PendingRequests)
{
    var card = Model.Cards[request.Id];
    <section class="panel">
        <h3>@card.ClaimedName, through @card.ProviderClaim (@card.ProviderClaimLabel)</h3>
        <p>Level: @HomeNode.Data.StateWording.ForLevel(card.Level). @card.LevelConsequences</p>
        @if (Model.HouseSideOpen)
        {
            <p>Check phrase: <strong>@card.CheckPhrase</strong>. Ask the person, through a channel you already trust, what words they see. If the words do not match, this is not their request.</p>
        }
        else
        {
            <p>Check phrase: shown only to the house side. Present the house secret above to see it.</p>
        }
        <p>Their claimed id: @card.ClaimedPartyId<br />
        Key fingerprint (a short code from their public key): <code>@card.Fingerprint</code></p>
        <p>Invited by @card.InviterName, request made @card.CreatedAtUtc.ToString("g") UTC.</p>
        @if (Model.HouseSideOpen)
        {
            <p>Confirm only a join you invited yourself, in your own name.</p>
            <form method="post" asp-page-handler="Confirm">
                <input type="hidden" name="houseSecret" value="@Model.PresentedHouseSecret" />
                <input type="hidden" name="joinRequestId" value="@request.Id" />
                <label>Confirming inviter
                    <select name="inviterPersonId">
                        @foreach (var person in Model.People)
                        {
                            <option value="@person.Id">@person.DisplayName</option>
                        }
                    </select>
                </label>
                <label>This connection speaks for
                    <select name="personId">
                        @foreach (var person in Model.People)
                        {
                            <option value="@person.Id">@person.DisplayName</option>
                        }
                    </select>
                </label>
                <label>Check phrase you heard
                    <input type="text" name="checkPhrase" />
                </label>
                <button type="submit">Confirm this join</button>
            </form>
            <form method="post" asp-page-handler="Decline">
                <input type="hidden" name="houseSecret" value="@Model.PresentedHouseSecret" />
                <input type="hidden" name="joinRequestId" value="@request.Id" />
                <label>Declining inviter
                    <select name="inviterPersonId">
                        @foreach (var person in Model.People)
                        {
                            <option value="@person.Id">@person.DisplayName</option>
                        }
                    </select>
                </label>
                <button type="submit">Decline this join</button>
            </form>
        }
    </section>
}

<h2>Connected</h2>
@if (Model.Connections.Count == 0)
{
    <p>No connections yet.</p>
}
<ul class="record-list">
    @foreach (var connection in Model.Connections)
    {
        <li class="record-item">
            <div>@connection.Person?.DisplayName, through @connection.ProviderClaim (their own claim, not checked), level @HomeNode.Data.StateWording.ForLevel(connection.Level), Status: @HomeNode.Data.StateWording.ForStanding(connection.Standing)</div>
            <div>Connection @connection.ConnectionId &middot; enrolled by @connection.EnrollingInviterPerson?.DisplayName</div>
            <div>Their claimed id: @connection.PartyId &middot; Key fingerprint (a short code from their public key): <code>@connection.Fingerprint</code></div>
            @if (Model.HouseSideOpen && connection.Standing == HomeNode.Data.ConnectionStanding.Active)
            {
                <form method="post" asp-page-handler="Revoke">
                    <input type="hidden" name="houseSecret" value="@Model.PresentedHouseSecret" />
                    <input type="hidden" name="connectionId" value="@connection.ConnectionId" />
                    <button type="submit">Revoke this connection</button>
                </form>
            }
        </li>
    }
</ul>
