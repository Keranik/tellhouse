@page
@model HomeNode.Pages.ConnectionsModel
@{
    ViewData["Title"] = "Connections";
}

<h1>Connections</h1>
<p>People's assistants connected to this household, and what each can do. No one joins until the person who invited them approves.</p>

@if (Model.Note is not null)
{
    <p>@Model.Note</p>
}
@if (Model.HouseSideOpen && Model.NewInviteCode is not null)
{
    <p>Invite code, shown once. Share it with @Model.NewInviteFor: <code>@Model.NewInviteCode</code></p>
}

@if (!Model.HouseSideOpen)
{
    <div class="panel">
    <h2>Admin controls are locked</h2>
    <p>The admin controls are locked. You can still see who's connected.</p>
    <form method="post" asp-page-handler="Unlock">
        <label>Admin passcode
            <input type="password" name="houseSecret" />
        </label>
        <button type="submit">Unlock</button>
    </form>
    </div>
}
else
{
    <div class="panel">
    <h2>Invite someone</h2>
    <form method="post" asp-page-handler="Invite">
        <label>Invited by
            <select name="inviterPersonId">
                @foreach (var person in Model.People)
                {
                    <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
            </select>
        </label>
        <label>Who's joining
            <select name="intendedPersonId">
                @foreach (var person in Model.People)
                {
                    <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
            </select>
        </label>
        <label>Access
            <select name="level">
                <option value="Standard">Member</option>
                <option value="KnockOnly">Request only</option>
            </select>
        </label>
        <button type="submit">Create invite code</button>
    </form>
    </div>
}

<h2>Requests to join</h2>
@if (Model.PendingRequests.Count == 0)
{
    <p>No pending requests.</p>
}
@foreach (var request in Model.PendingRequests)
{
    var card = Model.Cards[request.Id];
    var claimedFirst = HomeNode.Data.NameWording.First(card.ClaimedName);
    <section class="panel">
        <h3>@claimedFirst — @claimedFirst's assistant (demo stand-in)</h3>
        <p>Access: @HomeNode.Data.StateWording.ForLevel(card.Level). @card.LevelConsequences</p>
        @if (Model.HouseSideOpen)
        {
            <p>Verification phrase: <strong>@card.CheckPhrase</strong>. Call or text @claimedFirst and ask what phrase @claimedFirst's assistant shows. Approve only if it matches.</p>
        }
        else
        {
            <p>Verification phrase: shown only when the admin controls are unlocked.</p>
        }
        <p>Requested @HomeNode.Data.HouseholdTime.Stamp(card.CreatedAtUtc, Model.HouseholdZone)</p>
        <details>
            <summary>Technical details</summary>
            <p>Claimed id: @card.ClaimedPartyId<br />
            Key fingerprint: <code>@card.Fingerprint</code><br />
            Provider: @card.ProviderClaim (@card.ProviderClaimLabel)<br />
            Invited by @HomeNode.Data.NameWording.First(card.InviterName)</p>
        </details>
        @if (Model.HouseSideOpen)
        {
            <form method="post" asp-page-handler="Confirm">
                <input type="hidden" name="joinRequestId" value="@request.Id" />
                <label>Approved by
                    <select name="inviterPersonId">
                        @foreach (var person in Model.People)
                        {
                            <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                        }
                    </select>
                </label>
                <label>Connects as
                    <select name="personId">
                        @foreach (var person in Model.People)
                        {
                            <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                        }
                    </select>
                </label>
                <label>Phrase @claimedFirst read to you
                    <input type="text" name="checkPhrase" />
                </label>
                <button type="submit">Approve</button>
            </form>
            <form method="post" asp-page-handler="Decline">
                <input type="hidden" name="joinRequestId" value="@request.Id" />
                <label>Declined by
                    <select name="inviterPersonId">
                        @foreach (var person in Model.People)
                        {
                            <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                        }
                    </select>
                </label>
                <button type="submit">Decline</button>
            </form>
        }
    </section>
}

<h2>Connected</h2>
@if (Model.Connections.Count == 0)
{
    <p>No connections yet.</p>
}
<ul class="record-list">
    @foreach (var connection in Model.Connections)
    {
        var personFirst = HomeNode.Data.NameWording.First(connection.Person?.DisplayName);
        <li class="record-item">
            <div>@personFirst — @personFirst's assistant (demo stand-in) &middot; @HomeNode.Data.StateWording.ForLevel(connection.Level) &middot; @HomeNode.Data.StateWording.ForStanding(connection.Standing)</div>
            <div>Approved by @HomeNode.Data.NameWording.First(connection.EnrollingInviterPerson?.DisplayName) &middot; Key @Model.ShortKey(connection.Fingerprint)</div>
            <details>
                <summary>Technical details</summary>
                <p>Connection @connection.ConnectionId<br />
                Claimed id: @connection.PartyId<br />
                Key fingerprint: <code>@connection.Fingerprint</code><br />
                Provider: @connection.ProviderClaim (their own claim, not checked)<br />
                Enrolled by @(connection.EnrollingInviterPerson?.DisplayName ?? "")</p>
            </details>
            @if (Model.HouseSideOpen && connection.Standing == HomeNode.Data.ConnectionStanding.Active)
            {
                <form method="post" asp-page-handler="Revoke">
                    <input type="hidden" name="connectionId" value="@connection.ConnectionId" />
                    <button type="submit">Remove access</button>
                </form>
            }
        </li>
    }
</ul>
