@page "/Member"
@model HomeNode.Pages.MemberModel
@using HomeNode.Data
@using HomeNode.Services
@{
    ViewData["Title"] = "Inbox";
    // The person this page shows, for the shell's person switcher.
    ViewData["AsPersonId"] = Model.Member?.Id;
    var memberFirst = NameWording.First(Model.Member?.DisplayName);
    var needs = Model.Needs;
    var timelineHref = "/Timeline";
    int? Picture(int? deliveryId) => deliveryId is int d && Model.Pictures.TryGetValue(d, out var callId) ? callId : null;
    TraceView Card(ActivityItem item) => new(item, new TraceOptions
    {
        PagePath = "/Member",
        ActorField = "personId",
        ActorId = Model.Member?.Id,
        HasCloseHandler = true,
        Compact = true,
        Zone = Model.HouseholdZone
    });
}

<div class="page-head">
    <span class="eyebrow">@Icons.Get("inbox", 13) Needs you</span>
    @if (Model.Member is null)
    {
        <h1>Inbox</h1>
        <p class="lede">What&rsquo;s waiting on each person, and what the house passed on to them. Choose someone to open their inbox.</p>
    }
    else
    {
        <h1>@memberFirst's inbox</h1>
        <p class="lede">What&rsquo;s waiting on @memberFirst, and what the house passed on. Nothing happens without a yes.</p>
    }
</div>

@if (!string.IsNullOrEmpty(Model.InboxNote))
{
    <p class="note-panel note-panel--ok" role="status">@Model.InboxNote</p>
}

@if (Model.Member is null)
{
    <div class="who-grid">
        @foreach (var person in Model.People.Where(p => !p.MinorFlag))
        {
            var first = NameWording.First(person.DisplayName);
            var count = Model.WaitingByPerson.GetValueOrDefault(person.Id);
            <a class="who-card" href="@CurrentPerson.SwitchHref(person.Id, "/Member")">
                <span class="avatar avatar--@PersonStyle.Slot(person.Id)" aria-hidden="true">@PersonStyle.Initial(first)</span>
                <span class="who-card-name">@first</span>
                <span class="who-card-count@(count > 0 ? " who-card-count--some" : "")">@(count == 0 ? "Nothing waiting" : count == 1 ? "1 thing waiting" : $"{count} things waiting")</span>
            </a>
        }
    </div>
    return;
}

<section class="inbox-section" aria-labelledby="yours">
    <div class="section-head">
        <h2 id="yours">Yours to answer</h2>
        <span class="muted small">@(needs!.YoursCount == 0 ? "Nothing waiting" : needs.YoursCount == 1 ? "1 thing" : $"{needs.YoursCount} things")</span>
    </div>

    @if (needs.YoursCount == 0)
    {
        <div class="empty"><p>Nothing is waiting on @memberFirst right now. When @memberFirst sends the house something that needs a yes, or the house passes something on, it shows up here.</p></div>
    }

    @foreach (var item in needs.YourProposals)
    {
        <partial name="_Trace" model="Card(item)" />
    }

    @foreach (var ask in needs.Asks)
    {
        <article class="inbox-item inbox-item--ask">
            <header class="inbox-head">
                <span class="avatar avatar--0" aria-hidden="true">@Icons.Get("shield", 14)</span>
                <div class="trace-head-text">
                    <span class="trace-who">The house is asking</span>
                    <span class="trace-sub">Who should see an entry about @memberFirst?</span>
                </div>
                <span class="status status--waiting">Needs your answer</span>
            </header>
            <p class="claim-meta">Until @memberFirst chooses, only the people the entry names can see it.</p>
            <form method="post" class="decide">
                <input type="hidden" name="askId" value="@ask.Id" />
                <input type="hidden" name="personId" value="@Model.Member.Id" />
                <button type="submit" name="choice" value="Private" class="primary" formaction="/Member?handler=AnswerAsk">Only the people it names</button>
                <button type="submit" name="choice" value="Household" formaction="/Member?handler=AnswerAsk">Everyone in the household</button>
            </form>
        </article>
    }

    @foreach (var question in needs.PlanQuestions)
    {
        <article class="inbox-item inbox-item--plan">
            <header class="inbox-head">
                <span class="avatar avatar--0" aria-hidden="true">@Icons.Get("record", 14)</span>
                <div class="trace-head-text">
                    <span class="trace-who">@question.Plan.Label</span>
                    <span class="trace-sub">A plan item waiting on @memberFirst's answer</span>
                </div>
                <span class="status status--waiting">Your answer</span>
            </header>
            <p class="inbox-words">@question.Element.BodyText</p>
            <form method="post" class="decide">
                <input type="hidden" name="elementId" value="@question.Element.Id" />
                <input type="hidden" name="personId" value="@Model.Member.Id" />
                <button type="submit" name="disposal" value="Agreed" class="primary" formaction="/Member?handler=AnswerPlan">Agree</button>
                <button type="submit" name="disposal" value="Declined" formaction="/Member?handler=AnswerPlan">Not this time</button>
                <a class="decide-note" href="/Plans">Suggest a change on Plans</a>
            </form>
        </article>
    }

    @foreach (var item in needs.NewDeliveries.OrderByDescending(r => r.AtUtc))
    {
        <partial name="_Delivery" model="new DeliveryView(item, Model.Traces.GetValueOrDefault(item.AlertDeliveryId ?? 0), Model.Member, Model.People, Model.HouseholdZone, timelineHref, Picture(item.AlertDeliveryId))" />
    }
</section>

@if (needs.OtherProposals.Count > 0)
{
    <section class="inbox-section" aria-labelledby="others">
        <div class="section-head">
            <h2 id="others">Also waiting for a yes</h2>
            <span class="muted small">Anyone in the household who can see these may answer</span>
        </div>
        @foreach (var item in needs.OtherProposals)
        {
            <partial name="_Trace" model="Card(item)" />
        }
    </section>
}

@if (needs.OpenClaims.Count > 0)
{
    <section class="inbox-section" aria-labelledby="claims">
        <div class="section-head">
            <h2 id="claims">What @memberFirst has taken on</h2>
            <a class="muted small" href="/Promises">Close a claim on Claims</a>
        </div>
        <ul class="claim-list">
            @foreach (var claim in needs.OpenClaims)
            {
                <li class="claim-row">@Icons.Get("check", 14) <span>@claim.CommitmentText</span>@if (claim.DueText is not null) {<span class="muted small"> &middot; @claim.DueText</span>}</li>
            }
        </ul>
    </section>
}

@if (needs.SeenDeliveries.Count > 0)
{
    <details class="inbox-section fold">
        <summary><h2>Seen and earlier</h2> <span class="muted small">@needs.SeenDeliveries.Count</span></summary>
        @foreach (var item in needs.SeenDeliveries.OrderByDescending(r => r.AtUtc))
        {
            <partial name="_Delivery" model="new DeliveryView(item, Model.Traces.GetValueOrDefault(item.AlertDeliveryId ?? 0), Model.Member, Model.People, Model.HouseholdZone, timelineHref, Picture(item.AlertDeliveryId))" />
        }
    </details>
}

<p class="note-panel" style="margin-top:1.25rem">In the full product, what the house passes on reaches @memberFirst through @memberFirst's own assistant. In this demo, you see it here.</p>
