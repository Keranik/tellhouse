@page "/Member"
@model HomeNode.Pages.MemberModel
@{
    ViewData["Title"] = "Inbox";
    var memberFirst = HomeNode.Data.NameWording.First(Model.Member?.DisplayName);
}

@if (Model.Member is not null)
{
    <h1>@memberFirst's inbox</h1>
    <p>Messages Tellhouse delivered to @memberFirst. Only @memberFirst sees these.</p>
    <p class="note-panel">In the full product, these reach @memberFirst through @memberFirst's own assistant. In this demo, you see them here.</p>
}
else
{
    <h1>Inbox</h1>
}

<form method="get">
    <label>
        Viewing as
        <select name="personId" onchange="this.form.submit()">
            @foreach (var person in Model.People)
            {
                if (Model.Member?.Id == person.Id)
                {
                    <option value="@person.Id" selected>@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
                else
                {
                    <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
            }
        </select>
    </label>
</form>

@if (Model.Member is not null)
{
    @if (Model.Received.Count == 0)
    {
        <p>Nothing has been delivered to this person's inbox yet.</p>
    }
    <ul class="record-list">
        @foreach (var item in Model.Received)
        {
            <li class="record-item">
                @if (item.Source == "Alert" && item.AuthorName is not null)
                {
                    <strong>From @HomeNode.Data.NameWording.First(item.AuthorName) · @HomeNode.Data.HouseholdTime.Time(item.AtUtc, Model.HouseholdZone)</strong>
                    <text> — &ldquo;@item.Text&rdquo;</text>
                }
                else
                {
                    <strong>@item.Source:</strong> @item.Text
                    @if (!string.IsNullOrEmpty(item.Note))
                    {
                        <br />@item.Note
                    }
                }
                @if (item.Provenance is not null)
                {
                    <br />@item.Provenance
                }
                @if (item.AlertDeliveryId is int deliveryId)
                {
                    if (item.ClosedAtUtc is DateTime closedAt)
                    {
                        <br /><span>Seen @HomeNode.Data.HouseholdTime.Time(closedAt, Model.HouseholdZone)</span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Acknowledge">
                            <input type="hidden" name="deliveryId" value="@deliveryId" />
                            <input type="hidden" name="personId" value="@Model.Member.Id" />
                            <button type="submit">Mark as seen</button>
                        </form>
                    }
                }
            </li>
        }
    </ul>
}
