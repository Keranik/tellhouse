@page "/Member"
@model HomeNode.Pages.MemberModel
@using HomeNode.Data
@using HomeNode.Services
@{
    ViewData["Title"] = "Inbox";
    var memberFirst = NameWording.First(Model.Member?.DisplayName);
    var lensView = new LensView("/Member", "personId", Model.Member?.Id, Model.People, false, "Inbox of");
    var timelineHref = Model.Member is null ? "/Timeline" : $"/Timeline?ActorId={Model.Member.Id}";
    var unseen = Model.Received.Count(r => r.AlertDeliveryId is not null && r.ClosedAtUtc is null);
}

<div class="page-head">
    <span class="eyebrow">@Icons.Get("inbox", 13) Delivered to one person</span>
    @if (Model.Member is not null)
    {
        <h1>@memberFirst's inbox</h1>
        <p class="lede">What the house delivered to @memberFirst, after a person confirmed it. Only @memberFirst sees these. Each one shows how it got here.</p>
    }
    else
    {
        <h1>Inbox</h1>
    }
</div>

<partial name="_Lens" model="lensView" />

@if (Model.Member is not null)
{
    <p class="note-panel">In the full product, these reach @memberFirst through @memberFirst's own assistant. In this demo, you see them here.</p>

    @if (Model.Received.Count == 0)
    {
        <div class="empty" style="margin-top:1rem"><p>Nothing has been delivered to this person's inbox yet.</p></div>
    }
    else
    {
        <p class="muted small" style="margin-top:1rem">@Model.Received.Count delivered &middot; @unseen not marked as seen</p>
        <div class="inbox-list">
            @foreach (var item in Model.Received.OrderByDescending(r => r.AtUtc))
            {
                var isMessage = (item.Source == "Alert" || item.Source == "Message") && item.AuthorName is not null;
                var fromFirst = NameWording.First(item.AuthorName);
                Model.Traces.TryGetValue(item.AlertDeliveryId ?? 0, out var trace);
                <article class="inbox-item@(item.AlertDeliveryId is not null && item.ClosedAtUtc is null ? " inbox-item--unseen" : "")">
                    <header class="inbox-head">
                        @if (isMessage)
                        {
                            <span class="avatar avatar--@PersonStyle.Slot(Model.People.FirstOrDefault(p => p.DisplayName == item.AuthorName)?.Id)" aria-hidden="true">@PersonStyle.Initial(fromFirst)</span>
                            <div class="trace-head-text">
                                <span class="trace-who">From @fromFirst</span>
                                <span class="trace-sub">@(item.Source == "Alert" ? "Passed on by the house" : "A message, passed on") &middot; @HouseholdTime.TimeOrDate(item.AtUtc, Model.HouseholdZone)</span>
                            </div>
                        }
                        else
                        {
                            <span class="avatar avatar--0" aria-hidden="true">@Icons.Get("house", 14)</span>
                            <div class="trace-head-text">
                                <span class="trace-who">@item.Source</span>
                                <span class="trace-sub">@HouseholdTime.TimeOrDate(item.AtUtc, Model.HouseholdZone)</span>
                            </div>
                        }
                        @if (item.AlertDeliveryId is not null)
                        {
                            <span class="status status--@(item.ClosedAtUtc is null ? "sent" : "recorded")">@(item.ClosedAtUtc is DateTime seenAt ? $"Seen {HouseholdTime.TimeOrDate(seenAt, Model.HouseholdZone)}" : "Delivered")</span>
                        }
                    </header>
                    <p class="inbox-words">&ldquo;@item.Text&rdquo;</p>
                    @if (!string.IsNullOrEmpty(item.Note))
                    {
                        <p class="claim-meta">@item.Note</p>
                    }
                    @if (item.Provenance is not null)
                    {
                        <p class="claim-meta">@item.Provenance</p>
                    }
                    @if (trace is not null)
                    {
                        var entry = trace.Entries.FirstOrDefault();
                        <ol class="chain">
                            <li class="chain--person">
                                <span class="chain-icon">@Icons.Get("person", 12)</span>
                                <span>@trace.SpeakerName said it <span class="chain-when">&middot; @trace.ChannelLabel &middot; @HouseholdTime.TimeOrDate(trace.AtUtc, Model.HouseholdZone)</span></span>
                            </li>
                            <li class="chain--@(trace.Engine.Kind is "live" or "mock" ? "model" : "house")">
                                <span class="chain-icon">@Icons.Get(trace.Engine.Kind is "live" or "mock" ? "spark" : trace.Engine.Kind == "seed" ? "seed" : "shield", 12)</span>
                                <span>@(trace.Engine.Kind == "seed"
                                    ? (entry?.Action is { } seededAct ? $"Seeded with the action: {seededAct.Summary}" : "Seeded entry")
                                    : (trace.Engine.Kind switch { "live" => "Muse Spark", "mock" => "The local stand-in", "rule" => "The turn rule", _ => "The record" })
                                        + (entry?.Action is { } act ? $" proposed: {act.Summary}" : " recorded it"))</span>
                            </li>
                            @foreach (var step in trace.Entries.SelectMany(e => e.Outcome))
                            {
                                <li class="chain--@(step.Actor == "delivery" ? "delivery" : step.Actor is "person" or "assistant" ? "person" : "house")">
                                    <span class="chain-icon">@Icons.Get(step.Actor == "delivery" ? "send" : step.Actor is "person" or "assistant" ? "person" : "house", 12)</span>
                                    <span>@step.Who @step.Text@if (step.AtUtc is DateTime at) {<span class="chain-when"> &middot; @HouseholdTime.TimeOrDate(at, Model.HouseholdZone)</span>}</span>
                                </li>
                            }
                            <li class="chain--house">
                                <span class="chain-icon">@Icons.Get("code", 12)</span>
                                <span><a href="@(timelineHref)#@trace.Key">See the whole trace on the timeline</a></span>
                            </li>
                        </ol>
                    }
                    @if (item.AlertDeliveryId is int deliveryId && item.ClosedAtUtc is null)
                    {
                        <form method="post" asp-page-handler="Acknowledge">
                            <input type="hidden" name="deliveryId" value="@deliveryId" />
                            <input type="hidden" name="personId" value="@Model.Member.Id" />
                            <button type="submit">Mark as seen</button>
                        </form>
                    }
                </article>
            }
        </div>
    }
}
