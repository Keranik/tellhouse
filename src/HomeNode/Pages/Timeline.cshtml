@page "/Timeline"
@model HomeNode.Pages.TimelineModel
@{
    ViewData["Title"] = "Timeline";
}

<h1>Timeline</h1>
<p>Everything the household has told Tellhouse, newest first.</p>

<form method="get">
    <label>
        Viewing as
        <select name="ActorId" onchange="this.form.submit()">
            @if (Model.ActorId is null)
            {
                <option value="" selected>Household view</option>
            }
            else
            {
                <option value="">Household view</option>
            }
            @foreach (var person in Model.People)
            {
                if (Model.ActorId == person.Id)
                {
                    <option value="@person.Id" selected>@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
                else
                {
                    <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
            }
        </select>
    </label>
</form>

@if (Model.Note is not null)
{
    <p>@Model.Note</p>
}

@if (Model.Events.Count == 0)
{
    <p>Nothing recorded yet.</p>
}
else
{
    <div class="panel panel-table timeline-entries-panel">
    <table class="table timeline-entries">
        <thead>
            <tr>
                <th>Entry</th>
                <th>From</th>
                <th>About</th>
                <th>Type</th>
                <th>Status</th>
                <th>When</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Events)
            {
                <tr>
                    <td>
                        @item.Body
                        @if (HomeNode.Services.ProvenanceRendering.Describe(item) is { } provenance)
                        {
                            <br />@provenance
                        }
                    </td>
                    <td>@(item.AuthorPerson is not null ? HomeNode.Data.NameWording.First(item.AuthorPerson.DisplayName) : "The house")</td>
                    <td>@HomeNode.Data.NameWording.First(item.SubjectPerson?.DisplayName)</td>
                    <td>@HomeNode.Data.EventKindWording.For(item.Type)</td>
                    <td>
                        @if (item.ConfirmationState == HomeNode.Data.ConfirmationState.Proposed)
                        {
                            <span class="state-action">@HomeNode.Data.ConfirmationWording.For(item.ConfirmationState)</span>
                        }
                        else
                        {
                            @Model.StateText(item)
                        }
                    </td>
                    <td>@Model.ToHouseholdTime(item.CreatedAtUtc).ToString("MMM d, h:mm tt")</td>
                    <td>
                        @if (Model.ActorId is not null && item.ConfirmationState == HomeNode.Data.ConfirmationState.Proposed && !item.RecordPending)
                        {
                            <form method="post" asp-page-handler="Confirm">
                                <input type="hidden" name="eventId" value="@item.Id" />
                                <input type="hidden" name="actorId" value="@Model.ActorId" />
                                <button type="submit">Confirm</button>
                            </form>
                            <form method="post" asp-page-handler="Decline">
                                <input type="hidden" name="eventId" value="@item.Id" />
                                <input type="hidden" name="actorId" value="@Model.ActorId" />
                                <button type="submit">Don't send</button>
                            </form>
                        }
                        else if (Model.ActorId is not null && item.RecordPending && item.ConfirmationState == HomeNode.Data.ConfirmationState.Proposed)
                        {
                            <form method="post" asp-page-handler="Close">
                                <input type="hidden" name="eventId" value="@item.Id" />
                                <input type="hidden" name="actorId" value="@Model.ActorId" />
                                <button type="submit">Confirm</button>
                            </form>
                            <form method="post" asp-page-handler="Decline">
                                <input type="hidden" name="eventId" value="@item.Id" />
                                <input type="hidden" name="actorId" value="@Model.ActorId" />
                                <button type="submit">Don't send</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@if (Model.Deliveries.Count > 0)
{
    <div class="panel panel-table">
    <h2>Delivered to @HomeNode.Data.NameWording.First(Model.People.FirstOrDefault(p => p.Id == Model.ActorId)?.DisplayName)</h2>
    <table class="table">
        <thead>
            <tr>
                <th>When</th>
                <th>To</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var delivery in Model.Deliveries)
            {
                <tr>
                    <td>@Model.ToHouseholdTime(delivery.DeliveredAtUtc).ToString("MMM d, h:mm tt")</td>
                    <td>@HomeNode.Data.NameWording.First(delivery.ToPerson?.DisplayName)</td>
                    <td>
                        @delivery.BodyText
                        @if (delivery.Event is not null && HomeNode.Services.ProvenanceRendering.Describe(delivery.Event) is { } deliveryProvenance)
                        {
                            <br />@deliveryProvenance
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<div class="panel panel-table">
<h2>Household supplies</h2>
@if (Model.Supplies.Count == 0)
{
    <p>No supplies tracked yet.</p>
}
else
{
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    <table class="table">
        <thead>
            <tr>
                <th>Item</th>
                <th>On hand</th>
                <th>Runs out</th>
                <th>Order by</th>
                <th>Who orders</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Supplies)
            {
                <tr>
                    <td>@Model.SupplyName(item)</td>
                    <td>@Model.HandText(item)</td>
                    <td>@(item.GetRunOutDate(today) == DateOnly.MaxValue ? "" : item.GetRunOutDate(today).ToString("MMM d"))</td>
                    <td>@(item.GetOrderByDate(today) == DateOnly.MaxValue ? "" : item.GetOrderByDate(today).ToString("MMM d"))</td>
                    <td>@HomeNode.Data.NameWording.First(item.AssignedPerson?.DisplayName)</td>
                </tr>
            }
        </tbody>
    </table>
}
</div>
