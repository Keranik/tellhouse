@page "/Timeline"
@model HomeNode.Pages.TimelineModel
@{
    ViewData["Title"] = "Family timeline";
}

<h1>Family timeline</h1>
<p>The shared record for the house, newest first, in the view of the
   reader named below. Picking a name in this demo shows that person's
   view; entries for named people appear only there.</p>

<form method="get">
    <label>
        Acting as
        <select name="ActorId" onchange="this.form.submit()">
            @if (Model.ActorId is null)
            {
                <option value="" selected>No reader named (house entries only)</option>
            }
            else
            {
                <option value="">No reader named (house entries only)</option>
            }
            @foreach (var person in Model.People)
            {
                if (Model.ActorId == person.Id)
                {
                    <option value="@person.Id" selected>@person.DisplayName</option>
                }
                else
                {
                    <option value="@person.Id">@person.DisplayName</option>
                }
            }
        </select>
    </label>
</form>

@if (Model.Note is not null)
{
    <p>@Model.Note</p>
}

@if (Model.Events.Count == 0)
{
    <p>Nothing recorded yet.</p>
}
else
{
    <div class="panel panel-table">
    <table class="table">
        <thead>
            <tr>
                <th>When</th>
                <th>Added by</th>
                <th>About</th>
                <th>Kind</th>
                <th>Words</th>
                <th>State</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Events)
            {
                <tr>
                    <td>@Model.ToHouseholdTime(item.CreatedAtUtc).ToString("MMM d, h:mm tt")</td>
                    <td>@(item.AuthorPerson?.DisplayName ?? "Told to the house")</td>
                    <td>@(item.SubjectPerson?.DisplayName ?? "")</td>
                    <td>@HomeNode.Data.EventKindWording.For(item.Type)</td>
                    <td>
                        @item.Body
                        @if (HomeNode.Services.ProvenanceRendering.Describe(item) is { } provenance)
                        {
                            <br />@provenance
                        }
                    </td>
                    <td>
                        @HomeNode.Data.ConfirmationWording.For(item.ConfirmationState)
                        @if (item.RecordPending)
                        {
                            <text><br />Not yet closed by a person</text>
                        }
                    </td>
                    <td>
                        @if (Model.ActorId is not null && item.ConfirmationState == HomeNode.Data.ConfirmationState.Proposed && !item.RecordPending)
                        {
                            <form method="post" asp-page-handler="Confirm">
                                <input type="hidden" name="eventId" value="@item.Id" />
                                <input type="hidden" name="actorId" value="@Model.ActorId" />
                                <button type="submit">Confirm</button>
                            </form>
                            <form method="post" asp-page-handler="Decline">
                                <input type="hidden" name="eventId" value="@item.Id" />
                                <input type="hidden" name="actorId" value="@Model.ActorId" />
                                <button type="submit">Decline</button>
                            </form>
                        }
                        else if (Model.ActorId is not null && item.RecordPending && item.ConfirmationState == HomeNode.Data.ConfirmationState.Proposed)
                        {
                            <form method="post" asp-page-handler="Close">
                                <input type="hidden" name="eventId" value="@item.Id" />
                                <input type="hidden" name="actorId" value="@Model.ActorId" />
                                <button type="submit">Close and confirm this entry</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@if (Model.Deliveries.Count > 0)
{
    <div class="panel panel-table">
    <h2>Delivered to this reader</h2>
    <p>Deliveries for the person named above, in the words that were
       confirmed. Picking that person's name in this demo shows this
       list.</p>
    <table class="table">
        <thead>
            <tr>
                <th>When</th>
                <th>To</th>
                <th>Words carried, word for word</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var delivery in Model.Deliveries)
            {
                <tr>
                    <td>@Model.ToHouseholdTime(delivery.DeliveredAtUtc).ToString("MMM d, h:mm tt")</td>
                    <td>@(delivery.ToPerson?.DisplayName ?? "")</td>
                    <td>
                        @delivery.BodyText
                        @if (delivery.Event is not null && HomeNode.Services.ProvenanceRendering.Describe(delivery.Event) is { } deliveryProvenance)
                        {
                            <br />@deliveryProvenance
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<div class="panel panel-table">
<h2>Household supplies</h2>
@if (Model.Supplies.Count == 0)
{
    <p>No supplies tracked yet.</p>
}
else
{
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    <table class="table">
        <thead>
            <tr>
                <th>Item</th>
                <th>On hand</th>
                <th>Runs out</th>
                <th>Order by</th>
                <th>Orders it</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Supplies)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.QuantityOnHand @item.Unit</td>
                    <td>@(item.GetRunOutDate(today) == DateOnly.MaxValue ? "" : item.GetRunOutDate(today).ToString("MMM d"))</td>
                    <td>@(item.GetOrderByDate(today) == DateOnly.MaxValue ? "" : item.GetOrderByDate(today).ToString("MMM d"))</td>
                    <td>@(item.AssignedPerson?.DisplayName ?? "")</td>
                </tr>
            }
        </tbody>
    </table>
}
</div>
