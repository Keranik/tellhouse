@page "/"
@model HomeNode.Pages.FrontDoorModel
@{
    ViewData["Title"] = "Home";
}

<div class="front-door">
    <div class="hero">
        <h1>Tell the house.</h1>

        @if (Model.Household is not null)
        {
            <p class="house-name">Ellis household · @Model.People.Count people</p>
        }

        <p class="lead">Tell it once. Tellhouse writes it down, and asks before it tells anyone.</p>
    </div>

    @if (Model.HouseReply is not null)
    {
        <div class="panel panel-reply">
            <p>@Model.HouseReply</p>
            @if (Model.ProposedWords is not null)
            {
                <p class="reply-echo">&ldquo;@Model.ProposedWords&rdquo;</p>
            }
            @if (Model.PipelineNote is not null)
            {
                <p>@Model.PipelineNote</p>
            }
            @if (Model.ProposedEventId is int proposedId)
            {
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@proposedId" />
                    <label>
                        Viewing as
                        <select name="actorPersonId">
                            @foreach (var person in Model.People)
                            {
                                if (Model.ProposedAuthorId == person.Id)
                                {
                                    <option value="@person.Id" selected>@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                                }
                                else
                                {
                                    <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                                }
                            }
                        </select>
                    </label>
                    <div class="form-actions">
                        <button type="submit" formaction="?handler=Confirm" class="primary">@Model.ConfirmLabel</button>
                        <button type="submit" formaction="?handler=Decline">@Model.DeclineLabel</button>
                    </div>
                </form>
            }
        </div>
    }

    <div class="hero-input">
        <form method="post" asp-page-handler="Tell">
            <div class="speaker-row">
                <label>
                    Viewing as
                    <select name="speakerId">
                        @foreach (var person in Model.People)
                        {
                            <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                        }
                        <option value="">No name given</option>
                    </select>
                </label>
            </div>
            <label>
                <span class="visually-hidden">Message to the house</span>
                <textarea name="message" rows="3" placeholder="Try &quot;We're out of milk&quot;, &quot;I'll get Mia at 3&quot;, or &quot;Where's Daniel?&quot;"></textarea>
            </label>
            <div class="form-actions">
                <button type="submit" class="primary">Send</button>
            </div>
            <p class="muted-note">Nothing goes to anyone until you confirm.</p>
        </form>
    </div>

    @if (Model.StandIns.Count > 0)
    {
        <div class="panel">
            <h3 class="panel-title">Try a connected assistant</h3>
            @foreach (var standIn in Model.StandIns)
            {
                <p>@HomeNode.Data.NameWording.First(standIn.PersonName) uses their own AI assistant. Ask it to send the house a note; it writes the words itself.</p>
            }
            @if (Model.TestSendNote is not null)
            {
                <p>@Model.TestSendNote</p>
            }
            <form method="post" onsubmit="var b=this.querySelector('button[type=submit][data-sending]'); if(b){ b.disabled=true; b.textContent='Sending...'; }">
                @Html.AntiForgeryToken()
                @foreach (var standIn in Model.StandIns)
                {
                    <button type="submit" formaction="?handler=TestSend" name="standInName" value="@standIn.Name" data-sending="true">Send a note from @HomeNode.Data.NameWording.First(standIn.PersonName)'s assistant</button>
                }
            </form>
        </div>
    }

    <div class="panel">
        <h3 class="panel-title">Who sees your messages by default</h3>
        <p>Each person chooses who usually sees messages they add when
           they do not name anyone. Only that person can change their
           own choice, and a change applies only to messages added
           afterwards.</p>
        @if (Model.DefaultNote is not null)
        {
            <p>@Model.DefaultNote</p>
        }
        @if (Model.ReadBackText is not null)
        {
            <div class="panel panel-reply">
                <p>@Model.ReadBackText</p>
                @if (Model.PendingDefaultRequestId is int requestId)
                {
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="requestId" value="@requestId" />
                        <input type="hidden" name="actorPersonId" value="@Model.PendingDefaultHolderId" />
                        <div class="form-actions">
                            <button type="submit" formaction="?handler=ConfirmDefault" class="primary">Save</button>
                            <button type="submit" formaction="?handler=DeclineDefault">Cancel</button>
                        </div>
                    </form>
                }
            </div>
        }
        <ul class="default-list">
            @foreach (var row in Model.Defaults)
            {
                <li>@HomeNode.Data.NameWording.First(row.Person.DisplayName): @row.Label</li>
            }
        </ul>
        <form method="post" asp-page-handler="SetDefault">
            <label>
                Viewing as
                <select name="actorPersonId">
                    @foreach (var person in Model.People)
                    {
                        <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                    }
                </select>
            </label>
            <label>
                Set the default for
                <select name="holderPersonId">
                    @foreach (var person in Model.People)
                    {
                        <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                    }
                </select>
            </label>
            <label>
                Default
                <select name="value">
                    <option value="Private">Just me and anyone I name</option>
                    <option value="Household">Everyone in the household</option>
                    <option value="Ask">Ask me each time</option>
                </select>
            </label>
            <div class="form-actions">
                <button type="submit" class="primary">Save</button>
            </div>
        </form>
        <p>A change for someone else is only a suggestion. Only that
           person can set their own default.</p>
    </div>

    @if (Model.PendingAsks.Count > 0)
    {
        <div class="panel">
            <h3 class="panel-title">Needs your answer</h3>
            <p>Who should see this entry?</p>
            <p>Until you choose, only the people it names can see it.</p>
            @foreach (var ask in Model.PendingAsks)
            {
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="askId" value="@ask.Id" />
                    <input type="hidden" name="actorPersonId" value="@Model.ViewerId" />
                    <label>
                        Who should see this entry
                        <select name="choice">
                            <option value="Private">Only the people it names</option>
                            <option value="Household">Everyone in the household</option>
                        </select>
                    </label>
                    <div class="form-actions">
                        <button type="submit" formaction="?handler=AnswerAsk" class="primary">Save choice</button>
                    </div>
                </form>
            }
        </div>
    }

    <h2>Recent</h2>
    <form method="get">
        <label>
            Viewing as
            <select name="viewerId" onchange="this.form.submit()">
                <option value="">No one (shared entries only)</option>
                @foreach (var person in Model.People)
                {
                    if (Model.ViewerId == person.Id)
                    {
                        <option value="@person.Id" selected>@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                    }
                    else
                    {
                        <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                    }
                }
            </select>
        </label>
    </form>
    @if (Model.RecentEvents.Count == 0)
    {
        <p>Nothing here yet. Messages you send show up here.</p>
    }
    else
    {
        <ul class="record-list">
            @foreach (var item in Model.RecentEvents)
            {
                <li class="record-item">
                    <div class="record-body">@item.Body</div>
                    <div class="record-meta">
                        @if (item.AuthorPerson is not null)
                        {
                            <text>@HomeNode.Data.NameWording.First(item.AuthorPerson.DisplayName)</text>
                        }
                        else
                        {
                            <text>The house</text>
                        }
                        &middot; @HomeNode.Data.HouseholdTime.Time(item.CreatedAtUtc, Model.HouseholdZone)
                        @if (item.ConfirmationState == HomeNode.Data.ConfirmationState.Proposed)
                        {
                            <text> &middot; </text><span class="chip-action">Needs confirmation</span>
                            @if (Model.ViewerId is int recentViewer)
                            {
                                <form method="post" asp-page-handler="Confirm" class="inline-form">
                                    <input type="hidden" name="eventId" value="@item.Id" />
                                    <input type="hidden" name="actorPersonId" value="@recentViewer" />
                                    <button type="submit">Confirm</button>
                                </form>
                            }
                        }
                        @if (HomeNode.Services.ProvenanceRendering.Describe(item) is { } provenance)
                        {
                            <div>@provenance</div>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>
