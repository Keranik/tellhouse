@page "/"
@model HomeNode.Pages.FrontDoorModel
@{
    ViewData["Title"] = "Front door";
}

<div class="front-door">
    <div class="hero">
        <h1>Front door</h1>

        @if (Model.Household is not null)
        {
            <p class="house-name">@Model.Household.Name. Tell the house.</p>
        }

        <p class="lead">Talk here. Say what happened, ask a question, or leave a note for the house.
           What you say goes into the shared record. An entry meant for
           named people is shown only to them; the rest can be read and
           added to by everyone in the house.</p>
    </div>

    @if (Model.HouseReply is not null)
    {
        <div class="panel panel-reply">
            <p><strong>House reply:</strong> @Model.HouseReply</p>
            @if (Model.PipelineNote is not null)
            {
                <p>@Model.PipelineNote</p>
            }
            @if (Model.ProposedEventId is int proposedId)
            {
                <form method="post">
                    @Html.AntiForgeryToken()
                    <label>
                        Answering as
                        <select name="actorPersonId">
                            @foreach (var person in Model.People)
                            {
                                if (Model.ProposedAuthorId == person.Id)
                                {
                                    <option value="@person.Id" selected>@person.DisplayName</option>
                                }
                                else
                                {
                                    <option value="@person.Id">@person.DisplayName</option>
                                }
                            }
                        </select>
                    </label>
                    <div class="form-actions">
                        <button type="submit" formaction="?handler=Confirm" class="primary">Yes, confirm it</button>
                        <button type="submit" formaction="?handler=Decline">No, don't</button>
                    </div>
                </form>
            }
        </div>
    }

    <div class="hero-input">
        <h3 class="panel-title">Say a thing, or ask a question.</h3>
        <p>Type what you would say out loud. It is written into the record
           in the same way a spoken note would be. A telling is a note,
           message, or question you add to the house.</p>
        <form method="post" asp-page-handler="Tell">
            <div class="speaker-row">
                <label>
                    Who is telling the house?
                    <select name="speakerId">
                        @foreach (var person in Model.People)
                        {
                            <option value="@person.Id">@person.DisplayName</option>
                        }
                        <option value="">No name given</option>
                    </select>
                </label>
            </div>
            <label>
                Tell the house
                <textarea name="telling" rows="3" placeholder="Say it the way you would say it out loud."></textarea>
            </label>
            <div class="form-actions">
                <button type="submit" class="primary">Tell the house</button>
            </div>
        </form>
    </div>

    <div class="panel">
        <h3 class="panel-title">Test send from a family assistant.</h3>
        <p>Ask a family member's assistant to add a note to the house
           record, and watch it appear in the record below with a note
           of where it came from. The assistant writes the note itself,
           in its own words, and this button adds no words of yours. If
           the assistant cannot reach the house, nothing appears here.</p>
        @if (Model.TestSendNote is not null)
        {
            <p>@Model.TestSendNote</p>
        }
        @if (Model.StandIns.Count == 0)
        {
            <p>No family assistant is connected to this house right now,
               so there is nothing to press. This section appears whenever
               an assistant is connected.</p>
        }
        else
        {
            <form method="post">
                @Html.AntiForgeryToken()
                @foreach (var standIn in Model.StandIns)
                {
                    <button type="submit" formaction="?handler=TestSend" name="standInName" value="@standIn.Name">Test send: @standIn.PersonName's assistant sends a note</button>
                }
            </form>
        }
    </div>

    <div class="panel">
        <h3 class="panel-title">Audience defaults.</h3>
        <p>Each person can choose who usually sees notes they add when
           they do not name anyone: only them (Private), the whole house
           (Household), or be asked each time (Ask). Only that person
           can set or change their own choice, the change is shown back
           to them to check first, and it only affects notes added
           afterwards.</p>
        @if (Model.DefaultNote is not null)
        {
            <p>@Model.DefaultNote</p>
        }
        @if (Model.ReadBackText is not null)
        {
            <div class="panel panel-reply">
                <p><strong>Check this change:</strong> @Model.ReadBackText</p>
                @if (Model.PendingDefaultRequestId is int requestId)
                {
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="requestId" value="@requestId" />
                        <input type="hidden" name="actorPersonId" value="@Model.PendingDefaultHolderId" />
                        <div class="form-actions">
                            <button type="submit" formaction="?handler=ConfirmDefault" class="primary">Yes, set it</button>
                            <button type="submit" formaction="?handler=DeclineDefault">No, don't</button>
                        </div>
                    </form>
                }
            </div>
        }
        <ul class="default-list">
            @foreach (var row in Model.Defaults)
            {
                <li>@row.Person.DisplayName: @row.Label</li>
            }
        </ul>
        <form method="post" asp-page-handler="SetDefault">
            <label>
                I am
                <select name="actorPersonId">
                    @foreach (var person in Model.People)
                    {
                        <option value="@person.Id">@person.DisplayName</option>
                    }
                </select>
            </label>
            <label>
                Set the default for
                <select name="holderPersonId">
                    @foreach (var person in Model.People)
                    {
                        <option value="@person.Id">@person.DisplayName</option>
                    }
                </select>
            </label>
            <label>
                Default
                <select name="value">
                    <option value="Private">Private</option>
                    <option value="Household">Household</option>
                    <option value="Ask">Ask each time</option>
                </select>
            </label>
            <div class="form-actions">
                <button type="submit" class="primary">Tell the house</button>
            </div>
        </form>
        <p>An instruction about someone else's default is recorded as a
           proposal to that person. It is never applied by anyone but
           that person.</p>
    </div>

    @if (Model.PendingAsks.Count > 0)
    {
        <div class="panel">
            <h3 class="panel-title">Questions waiting for you.</h3>
            <p>One entry is being shown to as few people as possible
               until you choose who can see it. If you do not answer, it
               stays that way.</p>
            @foreach (var ask in Model.PendingAsks)
            {
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="askId" value="@ask.Id" />
                    <input type="hidden" name="actorPersonId" value="@Model.ViewerId" />
                    <label>
                        Audience for this entry
                        <select name="choice">
                            <option value="Private">Keep it visible to as few people as possible</option>
                            <option value="Household">Share it with the whole house</option>
                        </select>
                    </label>
                    <div class="form-actions">
                        <button type="submit" formaction="?handler=AnswerAsk" class="primary">Answer</button>
                    </div>
                </form>
            }
        </div>
    }

    <h2>Most recent in the shared record</h2>
    <form method="get">
        <label>
            Reading as
            <select name="viewerId" onchange="this.form.submit()">
                <option value="">No one (shared entries only)</option>
                @foreach (var person in Model.People)
                {
                    if (Model.ViewerId == person.Id)
                    {
                        <option value="@person.Id" selected>@person.DisplayName</option>
                    }
                    else
                    {
                        <option value="@person.Id">@person.DisplayName</option>
                    }
                }
            </select>
        </label>
    </form>
    <p>An entry meant for named people appears only to them. With no one
       named above, only the house's shared entries show.</p>
    @if (Model.RecentEvents.Count == 0)
    {
        <p>Nothing shows here for this reader yet.</p>
    }
    else
    {
        <ul class="record-list">
            @foreach (var item in Model.RecentEvents)
            {
                <li class="record-item">
                    <div class="record-body">@item.Body</div>
                    <div class="record-meta">
                        @if (item.AuthorPerson is not null)
                        {
                            <text>Added by @item.AuthorPerson.DisplayName</text>
                        }
                        else
                        {
                            <text>Told to the house</text>
                        }
                        &middot; <span class="state">@HomeNode.Data.ConfirmationWording.For(item.ConfirmationState)</span>
                        @if (item.RecordPending)
                        {
                            <text> &middot; waiting for someone in the house to confirm it</text>
                        }
                        @if (HomeNode.Services.ProvenanceRendering.Describe(item) is { } provenance)
                        {
                            <div>@provenance</div>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>
