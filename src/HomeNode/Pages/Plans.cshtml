@page "/Plans"
@model HomeNode.Pages.PlansModel
@{
    ViewData["Title"] = "Plans";
}

<h1>Plans</h1>
<p>People decide. An item settles only when everyone it names has
   agreed, in the same round (everyone answering the same wording), and
   the runner (the person who will go and do it) saying they have the
   plan is a separate act that never counts as agreement.</p>

@if (Model.Note is not null)
{
    <p>@Model.Note</p>
}

<form method="get">
    <label>
        Reading as
        <select name="ViewerId" onchange="this.form.submit()">
            <option value="">No reader named (house entries only)</option>
            @foreach (var person in Model.People)
            {
                if (Model.ViewerId == person.Id)
                {
                    <option value="@person.Id" selected>@person.DisplayName</option>
                }
                else
                {
                    <option value="@person.Id">@person.DisplayName</option>
                }
            }
        </select>
    </label>
</form>
<p>Open decisions are listed only for the reader named here, and only
   the ones that reader is meant to see. An entry built from a note
   written for named people shows only to the readers that note names.</p>

<div class="panel">
<h2>Start a plan</h2>
<form method="post" asp-page-handler="CreatePlan">
    <label>Plan name <input type="text" name="label" placeholder="Tonight" /></label>
    <label>Plan starts at <input type="time" name="anchorTime" /></label>
    <button type="submit">Start the plan</button>
</form>
</div>

@if (Model.OpenDecisions.Count > 0)
{
    <h2>Open decisions the record is holding</h2>
    <ul class="record-list">
        @foreach (var decision in Model.OpenDecisions)
        {
            <li class="record-item">@decision.Body</li>
        }
    </ul>
}

@foreach (var plan in Model.Plans)
{
    <div class="panel plan-panel">
    <h2>@plan.Label</h2>
    <p>
        Status: @HomeNode.Data.StateWording.ForPlan(plan.State)
        @if (plan.AnchorAtLocal is { } anchor)
        {
            <text> &middot; starts at @anchor.ToString("h:mm tt")</text>
        }
        @if (plan.RunnerPerson is not null)
        {
            <text> &middot; runner: @plan.RunnerPerson.DisplayName</text>
        }
    </p>

    @foreach (var element in plan.Elements)
    {
        if (!Model.ElementVisibleToViewer(element))
        {
            continue;
        }
        var required = HomeNode.Services.PlanAssemblyService.RequiredDisposers(element);
        <h3>@element.Kind: @element.BodyText</h3>
        <p>Status: @HomeNode.Data.StateWording.ForElement(element.State)</p>
        @if (required.Count > 0)
        {
            <ul>
                @foreach (var agreement in element.Agreements.OrderBy(a => a.Round).ThenBy(a => a.AtUtc))
                {
                    <li>
                        Round @agreement.Round: @(agreement.Person?.DisplayName ?? "") answered @HomeNode.Data.StateWording.ForDisposal(agreement.Disposal)
                        @if (agreement.CounterText is not null)
                        {
                            <text> &middot; in their words: &ldquo;@agreement.CounterText&rdquo;</text>
                        }
                    </li>
                }
            </ul>
            <form method="post" asp-page-handler="Dispose">
                <input type="hidden" name="elementId" value="@element.Id" />
                <label>
                    Answering as
                    <select name="personId">
                        @foreach (var personId in required)
                        {
                            var person = Model.People.FirstOrDefault(p => p.Id == personId);
                            <option value="@personId">@(person?.DisplayName ?? "")</option>
                        }
                    </select>
                </label>
                <label>
                    Answer
                    <select name="disposal">
                        <option value="Agreed">Agreed</option>
                        <option value="Declined">Declined</option>
                        <option value="Countered">Propose a change</option>
                    </select>
                </label>
                <label>
                    A change, in your own words (only when proposing a change)
                    <input type="text" name="counterText" placeholder="What you propose instead, word for word" />
                </label>
                <button type="submit">Record the answer</button>
            </form>
        }
        <form method="post" asp-page-handler="Retime">
            <input type="hidden" name="elementId" value="@element.Id" />
            <label>
                Re-time this entry, in the new words
                <input type="text" name="newText" value="@element.BodyText" />
            </label>
            <label>
                Changed by
                <select name="actorPersonId">
                    @foreach (var person in Model.People)
                    {
                        <option value="@person.Id">@person.DisplayName</option>
                    }
                </select>
            </label>
            <button type="submit">Record the new time</button>
        </form>
    }

    <h3>Add to this plan</h3>
    <form method="post" asp-page-handler="AddDinner">
        <input type="hidden" name="planId" value="@plan.Id" />
        <input type="hidden" name="viewerId" value="@Model.ViewerId" />
        @if (Model.OpenDecisions.Count > 0)
        {
            <label>
                From the open decision
                <select name="sourceEventId">
                    <option value="">None</option>
                    @foreach (var decision in Model.OpenDecisions)
                    {
                        <option value="@decision.Id">@decision.Body</option>
                    }
                </select>
            </label>
        }
        <label>Dinner proposed <input type="text" name="mealText" placeholder="What is proposed, in plain words" /></label>
        <fieldset>
            <legend>Who must agree</legend>
            @foreach (var person in Model.People)
            {
                <label>
                    <input type="checkbox" name="disposerIds" value="@person.Id" />
                    @person.DisplayName
                </label>
            }
        </fieldset>
        <button type="submit">Propose dinner</button>
    </form>
    <form method="post" asp-page-handler="AddList">
        <input type="hidden" name="planId" value="@plan.Id" />
        <label>The list <input type="text" name="listText" placeholder="What the runner picks up" /></label>
        <label>
            Runner
            <select name="runnerPersonId">
                @foreach (var person in Model.People)
                {
                    <option value="@person.Id">@person.DisplayName</option>
                }
            </select>
        </label>
        <button type="submit">Add the list</button>
    </form>
    <form method="post" asp-page-handler="AddLeaveBy">
        <input type="hidden" name="planId" value="@plan.Id" />
        <label>
            Stated durations, one per line as: name, minutes
            <textarea name="durationsText" rows="3" placeholder="drive to the store, 25"></textarea>
        </label>
        <button type="submit">Work out the leave-by</button>
    </form>
    <form method="post" asp-page-handler="Acknowledge">
        <input type="hidden" name="planId" value="@plan.Id" />
        <label>
            Runner acknowledging
            <select name="runnerPersonId">
                @foreach (var person in Model.People)
                {
                    <option value="@person.Id">@person.DisplayName</option>
                }
            </select>
        </label>
        <button type="submit">Acknowledge the plan</button>
    </form>
    </div>
}
