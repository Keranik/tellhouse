@page "/Plans"
@model HomeNode.Pages.PlansModel
@{
    ViewData["Title"] = "Plans";
}

<h1>Plans</h1>
<p>Plan dinner and errands together. A plan is settled when everyone on it agrees.</p>

@if (Model.Note is not null)
{
    <p>@Model.Note</p>
}

<form method="get">
    <label>
        Viewing as
        <select name="ViewerId" onchange="this.form.submit()">
            <option value="">Household view</option>
            @foreach (var person in Model.People)
            {
                if (Model.ViewerId == person.Id)
                {
                    <option value="@person.Id" selected>@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
                else
                {
                    <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
            }
        </select>
    </label>
</form>

<div class="panel">
<h2>Start a plan</h2>
<form method="post" asp-page-handler="CreatePlan">
    <label>Plan name <input type="text" name="label" placeholder="e.g., Tonight's dinner" /></label>
    <label>Start time (optional) <input type="time" name="anchorTime" /></label>
    <button type="submit">Create plan</button>
</form>
</div>

@if (Model.OpenDecisions.Count > 0)
{
    <h2>Open decisions</h2>
    <ul class="record-list">
        @foreach (var decision in Model.OpenDecisions)
        {
            <li class="record-item">@decision.Body</li>
        }
    </ul>
}

@if (Model.Plans.Count == 0)
{
    <p>No plans yet. Start one for tonight's dinner or this week's errands.</p>
}

@foreach (var plan in Model.Plans)
{
    <div class="panel plan-panel">
    <h2>@plan.Label</h2>
    <p>
        @HomeNode.Data.StateWording.ForPlan(plan.State)
        @if (plan.AnchorAtLocal is { } anchor)
        {
            <text> &middot; Starts @anchor.ToString("h:mm tt")</text>
        }
        @if (plan.RunnerPerson is not null)
        {
            <text> &middot; @HomeNode.Data.NameWording.First(plan.RunnerPerson.DisplayName) is going</text>
        }
    </p>

    @foreach (var element in plan.Elements)
    {
        if (!Model.ElementVisibleToViewer(element))
        {
            continue;
        }
        var required = HomeNode.Services.PlanAssemblyService.RequiredDisposers(element);
        var rounds = element.Agreements.Select(a => a.Round).Distinct().Count();
        <h3>@HomeNode.Data.PlanKindWording.For(element.Kind): @element.BodyText</h3>
        <p>@HomeNode.Data.StateWording.ForElement(element.State)</p>
        @if (required.Count > 0)
        {
            <ul>
                @foreach (var agreement in element.Agreements.OrderBy(a => a.Round).ThenBy(a => a.AtUtc))
                {
                    <li>
                        @if (rounds > 1)
                        {
                            <text>Round @agreement.Round · </text>
                        }
                        @switch (agreement.Disposal)
                        {
                            case HomeNode.Data.PlanDisposal.Agreed:
                                <text>@HomeNode.Data.NameWording.First(agreement.Person?.DisplayName) agreed</text>
                                break;
                            case HomeNode.Data.PlanDisposal.Declined:
                                <text>@HomeNode.Data.NameWording.First(agreement.Person?.DisplayName) declined</text>
                                break;
                            case HomeNode.Data.PlanDisposal.Countered:
                                <text>@HomeNode.Data.NameWording.First(agreement.Person?.DisplayName) suggested &ldquo;@agreement.CounterText&rdquo;</text>
                                break;
                        }
                    </li>
                }
            </ul>
            <form method="post" asp-page-handler="Dispose">
                <input type="hidden" name="elementId" value="@element.Id" />
                <label>
                    Viewing as
                    <select name="personId">
                        @foreach (var personId in required)
                        {
                            var person = Model.People.FirstOrDefault(p => p.Id == personId);
                            <option value="@personId">@HomeNode.Data.NameWording.First(person?.DisplayName)</option>
                        }
                    </select>
                </label>
                <label>
                    Your suggestion
                    <input type="text" name="counterText" placeholder="What you suggest instead, word for word" />
                </label>
                <div class="form-actions">
                    <button type="submit" name="disposal" value="Agreed" class="primary">Agree</button>
                    <button type="submit" name="disposal" value="Declined">Decline</button>
                    <button type="submit" name="disposal" value="Countered">Suggest a change</button>
                </div>
            </form>
        }
        <form method="post" asp-page-handler="Retime">
            <input type="hidden" name="elementId" value="@element.Id" />
            <label>
                New wording
                <input type="text" name="newText" value="@element.BodyText" />
            </label>
            <label>
                Changed by
                <select name="actorPersonId">
                    @foreach (var person in Model.People)
                    {
                        <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                    }
                </select>
            </label>
            <button type="submit">Save</button>
        </form>
    }

    <h3>Add to this plan</h3>
    <form method="post" asp-page-handler="AddDinner">
        <input type="hidden" name="planId" value="@plan.Id" />
        <input type="hidden" name="viewerId" value="@Model.ViewerId" />
        @if (Model.OpenDecisions.Count > 0)
        {
            <label>
                Based on
                <select name="sourceEventId">
                    <option value="">Nothing</option>
                    @foreach (var decision in Model.OpenDecisions)
                    {
                        <option value="@decision.Id">@decision.Body</option>
                    }
                </select>
            </label>
        }
        <label>Suggest dinner <input type="text" name="mealText" placeholder="e.g., Tacos" /></label>
        <fieldset>
            <legend>Who needs to agree</legend>
            @foreach (var person in Model.People)
            {
                <label>
                    <input type="checkbox" name="disposerIds" value="@person.Id" />
                    @HomeNode.Data.NameWording.First(person.DisplayName)
                </label>
            }
        </fieldset>
        <button type="submit">Suggest dinner</button>
    </form>
    <form method="post" asp-page-handler="AddList">
        <input type="hidden" name="planId" value="@plan.Id" />
        <label>Shopping list <input type="text" name="listText" placeholder="e.g., eggs, milk, gauze" /></label>
        <label>
            Who's going
            <select name="runnerPersonId">
                @foreach (var person in Model.People)
                {
                    <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
            </select>
        </label>
        <button type="submit">Add list</button>
    </form>
    <form method="post" asp-page-handler="AddLeaveBy">
        <input type="hidden" name="planId" value="@plan.Id" />
        <label>
            Travel and prep times
            <textarea name="durationsText" rows="3" placeholder="Drive to the store, 25"></textarea>
        </label>
        <p>One per line, e.g., Drive to the store, 25</p>
        <button type="submit">Calculate leave time</button>
    </form>
    <form method="post" asp-page-handler="Acknowledge">
        <input type="hidden" name="planId" value="@plan.Id" />
        <label>
            Who's going
            <select name="runnerPersonId">
                @foreach (var person in Model.People)
                {
                    <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
            </select>
        </label>
        <button type="submit">Confirm I'm going</button>
    </form>
    </div>
}
