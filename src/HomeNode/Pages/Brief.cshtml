@page "/Brief"
@model HomeNode.Pages.BriefModel
@using HomeNode.Data
@using HomeNode.Services
@{
    ViewData["Title"] = "Briefing";
    var first = HomeNode.Data.NameWording.First(Model.Viewer?.DisplayName);
    var lookupAnswer = Model.LookupAnswer;
    // The person this page shows, for the shell's person switcher.
    ViewData["AsPersonId"] = Model.Viewer?.Id;
    var claims = Model.Lines.Where(l => l.Section == "Claims still open").ToList();
    var toOrder = Model.Lines.Where(l => l.Section == "To order").ToList();
    var tasks = Model.Lines.Where(l => l.Section == "Your tasks").ToList();
    var timelineHref = Model.Viewer is null ? "/Timeline" : $"/Timeline?ActorId={Model.Viewer.Id}";
    string EngineWord(TraceEngine engine) => engine.Kind switch
    {
        "live" => "read by Muse Spark",
        "mock" => "read by the stand-in",
        "rule" => "shaped by the turn rule",
        "private" => "kept private, no model",
        "seed" => "seeded",
        _ => "recorded"
    };
}

<div class="page-head">
    <span class="eyebrow">@Icons.Get("shield", 13) The house now</span>
    @if (Model.Viewer is not null)
    {
        <h1>@first's briefing</h1>
        <p class="lede">The house right now, as @first may see it: what needs attention, who&rsquo;s on what, and what&rsquo;s running low.</p>
    }
    else
    {
        <h1>Briefing</h1>
        <p class="lede">Choose who you are at the top to see the house as they would.</p>
    }
</div>



@if (Model.Viewer is not null)
{
    string KindLabel(string kind) => kind switch
    {
        "conflict" => "Two claims",
        "slipping" => "Slipping",
        "running_low" => "Running low",
        "unanswered" => "No answer yet",
        "plan_gap" => "Plan",
        _ => "Note"
    };
    <section class="attention" aria-labelledby="attention">
        <div class="section-head">
            <h2 id="attention">What needs attention</h2>
            <p>Two readers look over the record for @first. Neither one acts: a finding is only a suggestion, and a draft is only words in the message box until @first sends it and says yes.</p>
        </div>
        <div class="attention-grid">
            <div class="attention-col attention-col--house">
                <h3>@Icons.Get("shield", 15) The house&rsquo;s own rules <span class="muted small">no model, private things included</span></h3>
                @if (Model.HouseFindings.Count == 0)
                {
                    <p class="muted small">Nothing the rules check for needs attention right now.</p>
                }
                @foreach (var f in Model.HouseFindings)
                {
                    <article class="finding finding--@f.Kind">
                        <span class="kind kind--@(f.Kind == "running_low" ? "supply" : f.Kind == "conflict" ? "claim" : "request")">@KindLabel(f.Kind)</span>
                        <p class="finding-head">@f.Headline</p>
                        <p class="finding-detail">@f.Detail</p>
                        @if (f.DraftMessage is not null)
                        {
                            <a class="finding-use" href="/?say=@Uri.EscapeDataString(f.DraftMessage)">Use this: &ldquo;@f.DraftMessage&rdquo; &rarr;</a>
                        }
                    </article>
                }
            </div>
            <div class="attention-col attention-col--wonder">
                <h3>@Icons.Get("bulb", 15) Muse Wonder&rsquo;s review <span class="muted small">Meta&rsquo;s reasoning model, shared record only</span></h3>
                @if (!Model.WonderAvailable)
                {
                    <p class="muted small">On a Live instance, Muse Wonder (muse-wonder-1.0, through the Meta Model API) looks over the shared record here and explains what it notices, citing the entries it used. This instance has no model key, so only the house&rsquo;s own rules are shown.</p>
                }
                else
                {
                    var wonderCall = Model.WonderCall;
                    var wonder = Model.Wonder;
                    var fresh = wonderCall is not null && wonderCall.Outcome != ModelCallOutcome.Failed
                        && DateTime.UtcNow - wonderCall.AtUtc < TimeSpan.FromMinutes(Model.WonderMinutes);
                    @if (wonderCall is not null)
                    {
                        var secs = wonderCall.ElapsedMs / 1000.0;
                        <p class="step-meta">@wonderCall.Model &middot; Meta Model API &middot; @secs.ToString("0.0") s &middot; reviewed @HouseholdTime.TimeOrDate(wonderCall.AtUtc, Model.HouseholdZone)@(wonder?.Dropped > 0 ? $" · {wonder.Dropped} finding{(wonder.Dropped == 1 ? "" : "s")} dropped by the house's checks" : "")</p>
                    }
                    @if (wonder?.Problem is not null)
                    {
                        <p class="note">@wonder.Problem Nothing changed.</p>
                    }
                    else if (wonder is not null)
                    {
                        @if (wonder.Summary is not null)
                        {
                            <p class="finding-summary">&ldquo;@wonder.Summary&rdquo;</p>
                        }
                        @if (wonder.Findings.Count == 0)
                        {
                            <p class="muted small">Muse Wonder found nothing that needs attention.</p>
                        }
                        @for (var i = 0; i < wonder.Findings.Count; i++)
                        {
                            var f = wonder.Findings[i];
                            <article class="finding finding--@f.Kind finding--wonder">
                                <span class="kind kind--@(f.Kind == "running_low" ? "supply" : f.Kind == "conflict" ? "claim" : "request")">@KindLabel(f.Kind)</span>
                                <p class="finding-head">@f.Headline</p>
                                <p class="finding-detail">@f.Detail</p>
                                @{
                                    var cites = f.EntryIds.Where(id => Model.Cited.ContainsKey(id)).ToList();
                                }
                                @if (cites.Count > 0 || f.SupplyIds.Count > 0)
                                {
                                    <ul class="finding-cites">
                                        @foreach (var id in cites)
                                        {
                                            var cited = Model.Cited[id];
                                            <li>#@id &middot; &ldquo;@cited.Words&rdquo;@(cited.Who.Length > 0 ? $" ({cited.Who})" : "")</li>
                                        }
                                        @foreach (var sid in f.SupplyIds.Where(Model.SupplyNames.ContainsKey))
                                        {
                                            <li>Supply &middot; @Model.SupplyNames[sid]</li>
                                        }
                                    </ul>
                                }
                                @if (f.DraftMessage is not null)
                                {
                                    @if (f.SentReadingId is not null)
                                    {
                                        <p class="finding-sent">@Icons.Get("check", 13) Sent as a message@(f.SentEdited ? ", in changed words" : "")</p>
                                    }
                                    else
                                    {
                                        <a class="finding-use" href="/?draft=@wonderCall!.Id&amp;f=@i">Use this draft: &ldquo;@f.DraftMessage&rdquo; &rarr;</a>
                                    }
                                }
                            </article>
                        }
                    }
                    <form method="post" asp-page-handler="Review" data-busy data-busy-label="Muse Wonder is reviewing… (this can take a little while)">
                        <input type="hidden" name="personId" value="@Model.Viewer.Id" />
                        @if (fresh)
                        {
                            <p class="muted small">Muse Wonder reviewed this a moment ago. You can ask again in a few minutes.</p>
                        }
                        else
                        {
                            <button type="submit" class="primary" data-wonder-ask>@Icons.Get("bulb", 15) @(wonderCall is null ? "Ask Muse Wonder what needs attention" : "Ask Muse Wonder again")</button>
                        }
                    </form>
                }
                <p class="muted small attention-never">Never shown to Muse Wonder: anything private. That stays with the house&rsquo;s own rules.</p>
            </div>
        </div>
    </section>
}

@if (Model.Viewer is not null)
{
    string[] palette = { "#94b8ff", "#f4c771", "#92d99a", "#f59b87", "#c9a7ff", "#7fd4c1" };
    <section class="shelf" aria-labelledby="shelf-title" id="shelf">
        <div class="section-head">
            <h2 id="shelf-title">What&rsquo;s on the shelf</h2>
            <p>Snap the pantry shelf and SAM 3.1 looks for each thing the house tracks, by name, and outlines what it finds. Nothing is written to the record: where it sees none, you can say so in one tap.</p>
        </div>
        <div class="shelf-grid">
            <div class="shelf-photo">
                @if (Model.ShelfCall is { } shelfCall && Model.Shelf is { } shelfResult && shelfCall.Image is not null)
                {
                    <figure class="shelf-figure">
                        <div class="shelf-frame">
                        <img src="/models/shelf/@shelfCall.Id" alt="The supply shelf photo, with what SAM 3.1 found outlined" width="@shelfResult.Width" height="@shelfResult.Height" />
                        <svg class="shelf-boxes" viewBox="0 0 @shelfResult.Width @shelfResult.Height" preserveAspectRatio="none" aria-hidden="true">
                            @for (var i = 0; i < shelfResult.Counts.Count; i++)
                            {
                                foreach (var box in shelfResult.Counts[i].Boxes)
                                {
                                    <rect x="@box.Left" y="@box.Top" width="@Math.Max(1, box.Right - box.Left)" height="@Math.Max(1, box.Bottom - box.Top)" fill="none" stroke="@palette[i % palette.Length]" stroke-width="@Math.Max(2, shelfResult.Width / 300)" rx="6" />
                                }
                            }
                        </svg>
                        </div>
                        <figcaption>@Icons.Get("eye", 13) SAM 3.1 &middot; @shelfCall.Model &middot; @((shelfCall.ElapsedMs / 1000.0).ToString("0.0")) s for @shelfResult.Counts.Count look@(shelfResult.Counts.Count == 1 ? "" : "s") side by side &middot; @HouseholdTime.TimeOrDate(shelfCall.AtUtc, Model.HouseholdZone)</figcaption>
                    </figure>
                }
                else
                {
                    <div class="shelf-empty">@Icons.Get("camera", 28)<p>@(Model.ShelfAvailable ? "No shelf check yet. Snap the shelf to start." : "On a Live instance, SAM 3.1 (through the Meta Model API) counts the tracked supplies in a photo of the shelf here. This instance has no model key.")</p></div>
                }
            </div>
            <div class="shelf-side">
                @if (Model.Shelf is { } counted)
                {
                    <ul class="shelf-counts">
                        @for (var i = 0; i < counted.Counts.Count; i++)
                        {
                            var c = counted.Counts[i];
                            <li>
                                <span class="shelf-dot" style="background:@palette[i % palette.Length]" aria-hidden="true"></span>
                                <span class="shelf-name">@c.Name</span>
                                <span class="shelf-count">@(c.Problem is not null ? "no answer" : c.Count == 0 ? "none seen" : $"{c.Count} seen")</span>
                                <span class="shelf-prompt">asked for &ldquo;@c.Prompt&rdquo;</span>
                                @if (c.Problem is null && c.Count == 0)
                                {
                                    <a class="finding-use" href="/?say=@Uri.EscapeDataString($"We're out of {c.Name}.")">Say it: &ldquo;We&rsquo;re out of @c.Name.&rdquo; &rarr;</a>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (Model.ShelfAvailable)
                {
                    <form method="post" enctype="multipart/form-data" asp-page-handler="Shelf" data-busy data-busy-label="SAM 3.1 is looking…" data-shelf-form>
                        <input type="hidden" name="personId" value="@Model.Viewer.Id" />
                        <input type="hidden" name="width" value="0" data-shelf-width />
                        <input type="hidden" name="height" value="0" data-shelf-height />
                        <label class="shelf-pick">
                            @Icons.Get("camera", 16) <span>Snap the shelf</span>
                            <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" capture="environment" data-shelf-input required />
                        </label>
                        <button type="submit" class="primary">Check it with SAM 3.1</button>
                    </form>
                }
                <p class="muted small">SAM looks for: @(Model.ShelfAsks.Count == 0 ? "nothing yet" : string.Join(", ", Model.ShelfAsks.Select(a => a.Name))). It looks for nothing else.</p>
            </div>
        </div>
    </section>
}
@if (Model.Viewer is not null)
{
    <div class="brief-grid">
        <section class="brief-card">
            <h2>@Icons.Get("check", 16) Who&rsquo;s on what <span class="count">@claims.Count</span><a class="card-more" href="/Promises">All claims &rarr;</a></h2>
            @if (claims.Count == 0)
            {
                <p class="muted small">No open claims @first can see.</p>
            }
            else
            {
                <ul class="brief-list">
                    @foreach (var line in claims)
                    {
                        <li>@line.Text</li>
                    }
                </ul>
            }
        </section>
        @if (!Model.HouseFindings.Any(f => f.Kind == "running_low"))
        {
        <section class="brief-card">
            <h2>@Icons.Get("record", 16) To order <span class="count">@toOrder.Count</span></h2>
            @if (toOrder.Count == 0)
            {
                <p class="muted small">Nothing @first orders is running out.</p>
            }
            else
            {
                <ul class="brief-list">
                    @foreach (var line in toOrder)
                    {
                        <li>@line.Text</li>
                    }
                </ul>
            }
        </section>
        }
        <section class="brief-card">
            <h2>@Icons.Get("clock", 16) Waiting on an answer <span class="count">@Model.Waiting.Sum(i => i.Entries.Count(e => e.Waiting || e.RecordPending))</span></h2>
            @if (Model.Waiting.Count == 0)
            {
                <p class="muted small">Nothing @first can see is waiting on a person.</p>
            }
            else
            {
                <ul class="brief-list">
                    @foreach (var item in Model.Waiting)
                    {
                        foreach (var entry in item.Entries.Where(e => e.Waiting || e.RecordPending))
                        {
                            <li class="brief-row">
                                <span class="avatar avatar--@PersonStyle.Slot(item.SpeakerId) avatar--sm" aria-hidden="true">@PersonStyle.Initial(item.SpeakerName)</span>
                                <span class="brief-text">@(entry.Action?.Summary ?? entry.Title)<span class="brief-who">@item.SpeakerName &middot; @HouseholdTime.TimeOrDate(item.AtUtc, Model.HouseholdZone) &middot; <a href="/Member">answer in the Inbox</a></span></span>
                            </li>
                        }
                    }
                </ul>
            }
        </section>
        <section class="brief-card">
            <h2>@Icons.Get("person", 16) @(tasks.Count > 0 ? "Tasks for " + first : "Where is someone?")@if (tasks.Count > 0) {<span class="count">@tasks.Count</span>}</h2>
            @if (tasks.Count > 0)
            {
                <ul class="brief-list">
                    @foreach (var line in tasks)
                    {
                        <li>@line.Text</li>
                    }
                </ul>
                <h3 style="margin-top:1rem">Where is someone?</h3>
            }
            <form method="post" asp-page-handler="Lookup" class="form-row">
                <input type="hidden" name="askerPersonId" value="@Model.Viewer.Id" />
                <label>
                    Person
                    <select name="subjectPersonId">
                        @foreach (var person in Model.People)
                        {
                            <option value="@person.Id">@NameWording.First(person.DisplayName)</option>
                        }
                    </select>
                </label>
                <button type="submit">Show last location</button>
            </form>
            @if (lookupAnswer is not null)
            {
                <p class="note" style="margin-top:0.75rem">@lookupAnswer</p>
            }
            <p class="muted small" style="margin-top:0.5rem">Answered from the record only, and only from entries @first may see.</p>
        </section>

        <section class="brief-card">
            <h2>@Icons.Get("record", 16) Plans <span class="count">@Model.OpenPlans.Count</span><a class="card-more" href="/Plans">Open Plans &rarr;</a></h2>
            @if (Model.OpenPlans.Count == 0)
            {
                <p class="muted small">Nothing is being arranged right now. Plans start from a message like &ldquo;What are we having for dinner tonight?&rdquo;</p>
            }
            else
            {
                <ul class="brief-list">
                    @foreach (var plan in Model.OpenPlans)
                    {
                        var open = plan.Elements.Count(e => e.State == PlanElementState.Open);
                        <li>@plan.Label@(plan.AnchorAtLocal is DateTime at ? $" · {at:h:mm tt}" : "") &middot; @(open == 0 ? "everything agreed" : open == 1 ? "1 item waiting" : $"{open} items waiting")</li>
                    }
                </ul>
            }
        </section>

        <section class="brief-card brief-card--wide">
            <h2>@Icons.Get("spark", 16) Latest entries @first may see <span class="count">@Model.Recent.Count</span></h2>
            @if (Model.Recent.Count == 0)
            {
                <p class="muted small">Nothing in the record for this person right now.</p>
            }
            else
            {
                <ul class="brief-list">
                    @foreach (var item in Model.Recent)
                    {
                        foreach (var entry in item.Entries)
                        {
                            <li class="brief-row">
                                <span class="avatar avatar--@PersonStyle.Slot(item.SpeakerId) avatar--sm" aria-hidden="true">@PersonStyle.Initial(item.SpeakerName)</span>
                                <span class="brief-text">
                                    <span class="kind kind--@entry.KindKey">@entry.KindLabel</span>
                                    @entry.Title
                                    <span class="brief-who">&ldquo;@entry.Event.Body&rdquo; &middot; @item.SpeakerName &middot; @HouseholdTime.TimeOrDate(item.AtUtc, Model.HouseholdZone) &middot; @EngineWord(item.Engine) &middot; @item.StatusLabel &middot; <a href="@(timelineHref)#@item.Key">trace</a></span>
                                </span>
                            </li>
                        }
                    }
                </ul>
            }
        </section>
    </div>
}
