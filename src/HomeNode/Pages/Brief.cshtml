@page "/Brief"
@model HomeNode.Pages.BriefModel
@{
    ViewData["Title"] = "Briefing";
}

<h1>Briefing</h1>
@if (Model.Viewer is not null)
{
    <p>What matters to @HomeNode.Data.NameWording.First(Model.Viewer.DisplayName): open claims, things to order, and recent entries @HomeNode.Data.NameWording.First(Model.Viewer.DisplayName) can see.</p>
}
else
{
    <p>What matters to the person named below: open claims, things to order, and recent entries they can see.</p>
}

<form method="get">
    <label>
        Viewing as
        <select name="PersonId" onchange="this.form.submit()">
            @foreach (var person in Model.People)
            {
                if (Model.Viewer?.Id == person.Id)
                {
                    <option value="@person.Id" selected>@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
                else
                {
                    <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
            }
        </select>
    </label>
</form>

@if (Model.Viewer is not null)
{
    <div class="panel">
    <h2>@HomeNode.Data.NameWording.First(Model.Viewer.DisplayName)'s briefing</h2>
    @if (Model.Lines.Count == 0)
    {
        <p>Nothing in the record for this person right now.</p>
    }
    else
    {
        var currentSection = "";
        foreach (var line in Model.Lines)
        {
            if (line.Section != currentSection)
            {
                currentSection = line.Section;
                <h3>@currentSection</h3>
            }
            <p>@line.Text</p>
        }
    }

    <h2>Where is someone?</h2>
    <form method="post" asp-page-handler="Lookup">
        @Html.AntiForgeryToken()
        <input type="hidden" name="askerPersonId" value="@Model.Viewer.Id" />
        <label>
            Person
            <select name="subjectPersonId">
                @foreach (var person in Model.People)
                {
                    <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
            </select>
        </label>
        <button type="submit">Show last location</button>
    </form>
    @if (Model.LookupAnswer is not null)
    {
        <p>@Model.LookupAnswer</p>
    }
    </div>
}
