@page "/Brief"
@model HomeNode.Pages.BriefModel
@{
    ViewData["Title"] = "Daily Summary";
}

<h1>Daily Summary</h1>
<p>What the record holds for one person. Entries reach a summary only
   when the audience written on them at the time (the people named to
   read it) includes that person.</p>

<form method="get">
    <label>
        Whose summary?
        <select name="PersonId" onchange="this.form.submit()">
            @if (Model.Viewer is null)
            {
                <option value="" selected>No reader named</option>
            }
            else
            {
                <option value="">No reader named</option>
            }
            @foreach (var person in Model.People)
            {
                if (Model.Viewer?.Id == person.Id)
                {
                    <option value="@person.Id" selected>@person.DisplayName</option>
                }
                else
                {
                    <option value="@person.Id">@person.DisplayName</option>
                }
            }
        </select>
    </label>
</form>
<p>Pick a person to see the record as they see it.</p>

@if (Model.Viewer is not null)
{
    <div class="panel">
    <h2>@Model.Viewer.DisplayName.Split(' ')[0]'s summary</h2>
    @if (Model.Lines.Count == 0)
    {
        <p>Nothing in the record for this person right now.</p>
    }
    else
    {
        var currentSection = "";
        foreach (var line in Model.Lines)
        {
            if (line.Section != currentSection)
            {
                currentSection = line.Section;
                <h3>@currentSection</h3>
            }
            <p>@line.Text</p>
        }
    }

    <h2>Look up a recorded place</h2>
    <form method="post" asp-page-handler="Lookup">
        @Html.AntiForgeryToken()
        <input type="hidden" name="askerPersonId" value="@Model.Viewer.Id" />
        <label>
            Last recorded place of
            <select name="subjectPersonId">
                @foreach (var person in Model.People)
                {
                    <option value="@person.Id">@person.DisplayName</option>
                }
            </select>
        </label>
        <button type="submit">Ask</button>
    </form>
    @if (Model.LookupAnswer is not null)
    {
        <p><strong>From the record:</strong> @Model.LookupAnswer</p>
    }
    </div>
}
else if (Model.People.Count > 0)
{
    <p>No reader named, so no summary is shown. A summary belongs to one
       person; name whose summary to read above.</p>
}
