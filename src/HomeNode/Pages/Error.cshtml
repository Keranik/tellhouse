@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (Model.ShowRequestId)
{
    <p>
        Reference (quote this if you report the problem): <code>@Model.RequestId</code>
    </p>
}

<p>Nothing was saved by the request that failed. Please try again, or go back and start over.</p>
