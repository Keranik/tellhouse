@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="page-head">
    <h1>Something went wrong</h1>
    <p class="lede">That didn't go through. Go back and try again.</p>
</div>

<p>
    <a href="javascript:history.back()">Go back</a>
    &middot;
    <a asp-page="/FrontDoor">Home</a>
    &middot;
    <a asp-page="/Timeline">Timeline</a>
</p>

@if (Model.ShowRequestId)
{
    <p class="muted small">
        Reference: <code>@Model.RequestId</code>
    </p>
}

<p class="note">Check the Timeline to see whether it landed before you send it again.</p>
