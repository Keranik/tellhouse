@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<h1>Something went wrong</h1>
<p>That didn't go through. Go back and try again.</p>

<p>
    <a href="javascript:history.back()">Go back</a>
    <a asp-page="/FrontDoor">Home</a>
</p>

@if (Model.ShowRequestId)
{
    <p>
        Reference: <code>@Model.RequestId</code>
    </p>
}

<p>Check Recent or Timeline to see whether it landed before you send it again.</p>
