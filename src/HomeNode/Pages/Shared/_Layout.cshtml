@inject Microsoft.Extensions.Options.IOptions<HomeNode.Services.Extraction.ExtractionOptions> ExtractionSettings
@{
    // The engine that reads messages on this deployment, named on
    // every page so a visitor always knows whether a real model is
    // reading their words: Muse Spark when the node runs Live, the
    // deterministic local stand-in otherwise.
    var extractionLive = ExtractionSettings.Value.Mode.Equals("Live", StringComparison.OrdinalIgnoreCase);
    var extractionModel = ExtractionSettings.Value.Model;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Tellhouse</title>
    <meta name="description" content="Tellhouse is a shared record for a household. Tell it once: it writes it down, asks before it tells anyone, and remembers who said what." />
    <meta property="og:title" content="Tellhouse" />
    <meta property="og:description" content="A shared record for a household. Tell it once: it writes it down, asks before it tells anyone, and remembers who said what." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HomeNode.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPath = Context.Request.Path.Value ?? "/";
        string NavClass(string pagePath) =>
            string.Equals(currentPath, pagePath, StringComparison.OrdinalIgnoreCase)
                ? "app-nav-link active" : "app-nav-link";
        string BottomClass(string pagePath) =>
            string.Equals(currentPath, pagePath, StringComparison.OrdinalIgnoreCase)
                ? "app-bottombar-link active" : "app-bottombar-link";
        string? NavCurrent(string pagePath) =>
            string.Equals(currentPath, pagePath, StringComparison.OrdinalIgnoreCase)
                ? "page" : null;
        var frontCurrent = NavCurrent("/");
        var timelineCurrent = NavCurrent("/Timeline");
        var briefCurrent = NavCurrent("/Brief");
        var memberCurrent = NavCurrent("/Member");
    }
    <div class="app-shell">
        <aside class="app-sidebar" id="app-sidebar">
            <a class="app-brand" asp-area="" asp-page="/FrontDoor">
                <span class="app-brand-mark" aria-hidden="true">
                    <img src="~/img/tellhouse-mark-white.svg" alt="" width="30" height="30" />
                </span>
                <span class="app-brand-text">
                    <span class="app-brand-name">Tellhouse</span>
                    <span class="app-brand-house">Ellis household</span>
                </span>
            </a>
            <nav class="app-nav" aria-label="Household">
                <a class="@NavClass("/")" asp-area="" asp-page="/FrontDoor">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M9.5 21v-6h5v6" /></svg>
                    <span>Home</span>
                </a>
                <a class="@NavClass("/Timeline")" asp-area="" asp-page="/Timeline">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 6H21M8.5 12H21M8.5 18H21" /><circle cx="4" cy="6" r="1" fill="currentColor" /><circle cx="4" cy="12" r="1" fill="currentColor" /><circle cx="4" cy="18" r="1" fill="currentColor" /></svg>
                    <span>Timeline</span>
                </a>
                <a class="@NavClass("/Brief")" asp-area="" asp-page="/Brief">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <span>Briefing</span>
                </a>
                <a class="@NavClass("/Plans")" asp-area="" asp-page="/Plans">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                    <span>Plans</span>
                </a>
                <a class="@NavClass("/Promises")" asp-area="" asp-page="/Promises">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8.2-7 10-3.5-1.8-7-5-7-10V6z" /><path d="M9 11.8l2.2 2.2 4-4.2" /></svg>
                    <span>Claims</span>
                </a>
                <a class="@NavClass("/Member")" asp-area="" asp-page="/Member">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2" /><path d="M5.5 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.7 1.1z" /></svg>
                    <span>Inbox</span>
                </a>
                <a class="@NavClass("/Connections")" asp-area="" asp-page="/Connections">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" /></svg>
                    <span>Connections</span>
                </a>
                <a class="@NavClass("/Model")" asp-area="" asp-page="/Model">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5l1.9 5.1 5.1 1.9-5.1 1.9L12 17.5l-1.9-5.1L5 10.5l5.1-1.9z" /><path d="M18.5 16.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z" /></svg>
                    <span>Model</span>
                </a>
            </nav>
            <hr class="app-nav-divider" aria-hidden="true" />
            <div class="app-sidebar-footer">
                <div class="app-engine">
                    @if (extractionLive)
                    {
                        <a class="engine-badge" asp-page="/Model"><span class="dot" aria-hidden="true"></span>Muse Spark is reading</a>
                        <p>Messages are read by Meta's @extractionModel through the Meta Model API.</p>
                    }
                    else
                    {
                        <a class="engine-badge engine-badge--mock" asp-page="/Model"><span class="dot" aria-hidden="true"></span>Local stand-in is reading</a>
                        <p>No model calls on this instance. Set it to Live with a Meta Model API key to read with Muse Spark.</p>
                    }
                </div>
                &copy; 2026 Tellhouse · Hackathon demo · <a href="https://github.com/Keranik/tellhouse">Source on GitHub</a>
            </div>
        </aside>
        <div class="app-scrim" data-drawer-scrim hidden></div>
        <div class="app-main">
            <header class="app-topbar">
                <button type="button" class="app-drawer-toggle" data-drawer-toggle
                        aria-expanded="false" aria-controls="app-sidebar"
                        aria-label="Open navigation">
                    <img src="~/img/tellhouse-mark-white.svg" alt="" width="26" height="26" aria-hidden="true" />
                    <span class="app-drawer-toggle-menu" aria-hidden="true"><span></span><span></span><span></span></span>
                </button>
                <span class="app-topbar-title">@ViewData["Title"]</span>
            </header>
            <div class="app-demo-banner">
                <p><strong>DEMO ENVIRONMENT</strong> &middot; The people in this house are invented, and <strong>no real family's data is in it.</strong></p>
            </div>
            <main role="main" class="app-canvas">
                @RenderBody()
            </main>
        </div>
    </div>
    <nav class="app-bottombar" aria-label="Main">
        <a class="@BottomClass("/")" asp-area="" asp-page="/FrontDoor" aria-label="Home" aria-current="@frontCurrent">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M9.5 21v-6h5v6" /></svg>
            <span class="app-bottombar-label">Home</span>
        </a>
        <a class="@BottomClass("/Timeline")" asp-area="" asp-page="/Timeline" aria-label="Timeline" aria-current="@timelineCurrent">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 6H21M8.5 12H21M8.5 18H21" /><circle cx="4" cy="6" r="1" fill="currentColor" /><circle cx="4" cy="12" r="1" fill="currentColor" /><circle cx="4" cy="18" r="1" fill="currentColor" /></svg>
            <span class="app-bottombar-label">Timeline</span>
        </a>
        <a class="@BottomClass("/Brief")" asp-area="" asp-page="/Brief" aria-label="Briefing" aria-current="@briefCurrent">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <span class="app-bottombar-label">Briefing</span>
        </a>
        <a class="@BottomClass("/Member")" asp-area="" asp-page="/Member" aria-label="Inbox" aria-current="@memberCurrent">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2" /><path d="M5.5 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.7 1.1z" /></svg>
            <span class="app-bottombar-label">Inbox</span>
        </a>
    </nav>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
