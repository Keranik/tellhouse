<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tellhouse</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HomeNode.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPath = Context.Request.Path.Value ?? "/";
        string NavClass(string pagePath) =>
            string.Equals(currentPath, pagePath, StringComparison.OrdinalIgnoreCase)
                ? "app-nav-link active" : "app-nav-link";
    }
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="app-brand" asp-area="" asp-page="/FrontDoor">
                <span class="app-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M9.5 21v-6h5v6" /></svg>
                </span>
                <span class="app-brand-name">Tellhouse</span>
            </a>
            <nav class="app-nav" aria-label="House">
                <p class="app-nav-heading">The house</p>
                <a class="@NavClass("/")" asp-area="" asp-page="/FrontDoor">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M9.5 21v-6h5v6" /></svg>
                    <span>Front door</span>
                </a>
                <a class="@NavClass("/Timeline")" asp-area="" asp-page="/Timeline">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 6H21M8.5 12H21M8.5 18H21" /><circle cx="4" cy="6" r="1" fill="currentColor" /><circle cx="4" cy="12" r="1" fill="currentColor" /><circle cx="4" cy="18" r="1" fill="currentColor" /></svg>
                    <span>Family timeline</span>
                </a>
                <a class="@NavClass("/Brief")" asp-area="" asp-page="/Brief">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <span>Daily Summary</span>
                </a>
                <a class="@NavClass("/Plans")" asp-area="" asp-page="/Plans">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                    <span>Plans</span>
                </a>
                <a class="@NavClass("/Promises")" asp-area="" asp-page="/Promises">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8.2-7 10-3.5-1.8-7-5-7-10V6z" /><path d="M9 11.8l2.2 2.2 4-4.2" /></svg>
                    <span>My Claims</span>
                </a>
                <a class="@NavClass("/Member")" asp-area="" asp-page="/Member">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2" /><path d="M5.5 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.7 1.1z" /></svg>
                    <span>Private Inbox</span>
                </a>
                <a class="@NavClass("/Connections")" asp-area="" asp-page="/Connections">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" /></svg>
                    <span>Connections</span>
                </a>
            </nav>
            <div class="app-sidebar-footer">&copy; 2026 - Tellhouse</div>
        </aside>
        <div class="app-main">
            <header class="app-topbar">
                <span class="app-topbar-title">@ViewData["Title"]</span>
                <span class="app-demo-chip"><strong>DEMO ENVIRONMENT</strong></span>
            </header>
            <div class="app-demo-banner">
                <p>Demo: the people in this house are invented, and <strong>no real family's data is in it.</strong></p>
            </div>
            <main role="main" class="app-canvas">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
