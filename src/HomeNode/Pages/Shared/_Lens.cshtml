@model HomeNode.Services.LensView
@using HomeNode.Data
@using HomeNode.Services
@*
    The person lens: whose view of the record a page shows. Plain
    links, one per person, so choosing a view is a navigation and
    never a form. The household view shows only shared entries; a
    person's view shows what that person's stored audiences admit.
*@
<nav class="lens" aria-label="@Model.Label">
    <span class="lens-label">@Model.Label</span>
    <div class="lens-chips">
        @if (Model.AllowHousehold)
        {
            var current = Model.Selected is null;
            <a class="lens-chip@(current ? " active" : "")" href="@Model.PagePath" aria-current="@(current ? "true" : null)">
                <span class="avatar avatar--0 avatar--sm" aria-hidden="true">@Icons.Get("house", 12)</span>Household
            </a>
        }
        @foreach (var person in Model.People)
        {
            var current = Model.Selected == person.Id;
            var first = NameWording.First(person.DisplayName);
            <a class="lens-chip@(current ? " active" : "")" href="@(Model.PagePath)?@(Model.ParamName)=@person.Id" aria-current="@(current ? "true" : null)">
                <span class="avatar avatar--@PersonStyle.Slot(person.Id) avatar--sm" aria-hidden="true">@PersonStyle.Initial(first)</span>@first
            </a>
        }
    </div>
</nav>
