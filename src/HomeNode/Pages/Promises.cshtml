@page "/Promises"
@model HomeNode.Pages.PromisesModel
@{
    ViewData["Title"] = "Promises";
}

<h1>Promises</h1>
<p>What a person who needs support has asked for or been promised, kept
   as first-class records. A promise closes only when a person says so,
   in words that join the record.</p>

@if (Model.Note is not null)
{
    <p><strong>@Model.Note</strong></p>
}

<form method="get">
    <label>
        Reading as
        <select name="ViewerId" onchange="this.form.submit()">
            <option value="">No reader named (house entries only)</option>
            @foreach (var person in Model.People)
            {
                if (Model.ViewerId == person.Id)
                {
                    <option value="@person.Id" selected>@person.DisplayName</option>
                }
                else
                {
                    <option value="@person.Id">@person.DisplayName</option>
                }
            }
        </select>
    </label>
</form>
<p>Promises are listed as the reader named here may see them, under
   the audience stored on the telling that made each promise.</p>

@if (Model.Promises.Count == 0)
{
    <p>No promises on the record yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Who promised</th>
                <th>Promised</th>
                <th>To whom</th>
                <th>When</th>
                <th>Standing</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var promise in Model.Promises)
            {
                <tr>
                    <td>@(promise.PromisorPerson?.DisplayName ?? "")</td>
                    <td>@promise.CommitmentText</td>
                    <td>@(promise.PromiseePerson?.DisplayName ?? "The house")</td>
                    <td>@(promise.DueText ?? "")</td>
                    <td>
                        @switch (promise.State)
                        {
                            case HomeNode.Data.PromiseState.Made:
                                <text>Still open</text>
                                break;
                            case HomeNode.Data.PromiseState.Kept:
                                <text>Kept, closed by @(promise.ClosedByPerson?.DisplayName ?? "")</text>
                                break;
                            case HomeNode.Data.PromiseState.Broken:
                                <text>Closed as broken by @(promise.ClosedByPerson?.DisplayName ?? "")</text>
                                break;
                            case HomeNode.Data.PromiseState.Released:
                                <text>Released by @(promise.ClosedByPerson?.DisplayName ?? "")</text>
                                break;
                        }
                    </td>
                    <td>
                        @if (promise.State == HomeNode.Data.PromiseState.Made)
                        {
                            <form method="post" asp-page-handler="Close" data-promisor="@promise.PromisorPersonId" data-promisee="@(promise.PromiseePersonId?.ToString() ?? "")">
                                <input type="hidden" name="promiseId" value="@promise.Id" />
                                <label>
                                    Closed by
                                    <select name="closerPersonId">
                                        @foreach (var person in Model.People)
                                        {
                                            <option value="@person.Id">@person.DisplayName</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    Outcome
                                    <select name="outcome">
                                        <option value="Kept">Kept</option>
                                        <option value="Broken">Broken</option>
                                        <option value="Released">Released</option>
                                    </select>
                                </label>
                                <label>
                                    The closing words
                                    <input type="text" name="closingWords" placeholder="What the person said" />
                                </label>
                                <button type="submit">Close this promise</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        // Released is offered only when it can apply to the closer
        // chosen in the same form: the promisee, or the maker when
        // the promise was made to the house. The server enforces the
        // same rule on submit; this only keeps the form honest.
        document.querySelectorAll('form[data-promisor]').forEach(function (form) {
            var closer = form.querySelector('select[name="closerPersonId"]');
            var outcome = form.querySelector('select[name="outcome"]');
            if (!closer || !outcome) { return; }
            var released = outcome.querySelector('option[value="Released"]');
            function updateReleased() {
                var promisee = form.getAttribute('data-promisee');
                var allowed = promisee
                    ? closer.value === promisee
                    : closer.value === form.getAttribute('data-promisor');
                released.disabled = !allowed;
                if (!allowed && outcome.value === 'Released') {
                    outcome.value = 'Kept';
                }
            }
            closer.addEventListener('change', updateReleased);
            updateReleased();
        });
    </script>
}
