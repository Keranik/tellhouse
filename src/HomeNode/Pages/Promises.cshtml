@page "/Promises"
@model HomeNode.Pages.PromisesModel
@using HomeNode.Data
@using HomeNode.Services
@{
    ViewData["Title"] = "Claims";
    var note = Model.Note;
    var lensView = new LensView("/Promises", "ViewerId", Model.ViewerId, Model.People, true);
    var timelineHref = Model.ViewerId is int tv ? $"/Timeline?ActorId={tv}" : "/Timeline";
    var open = Model.Promises.Count(p => p.State == HomeNode.Data.PromiseState.Made);
    string EngineSentence(ActivityItem? trace) => trace?.Engine.Kind switch
    {
        "live" => "Muse Spark read it as a claim",
        "mock" => "The local stand-in read it as a claim",
        "rule" => "A house rule shaped it",
        "seed" => "Part of the demo's starting record; no model read it",
        _ => "Recorded"
    };
}

<div class="page-head">
    <span class="eyebrow">@Icons.Get("check", 13) What people have taken on</span>
    <h1>Claims</h1>
    <p class="lede">When someone says &ldquo;I'll&hellip;&rdquo;, the model turns it into a claim the household can see: who took it on, for whom, and by when. It stays open until a person closes it in their own words. The house never closes a claim on a clock.</p>
</div>

<partial name="_Lens" model="lensView" />

@if (note is not null)
{
    <p class="note">@note</p>
}

@if (Model.Promises.Count == 0)
{
    <div class="empty"><p>No claims yet. When someone says &ldquo;I'll&hellip;&rdquo;, it shows up here.</p></div>
}
else
{
    <p class="muted small">@open open &middot; @(Model.Promises.Count - open) closed</p>
    <div class="claim-list">
        @foreach (var promise in Model.Promises)
        {
            var maker = NameWording.First(promise.PromisorPerson?.DisplayName);
            var forWhom = promise.PromiseePerson is null ? "the household" : NameWording.First(promise.PromiseePerson.DisplayName);
            var due = promise.DueAtLocal is { } dueAt ? dueAt.ToString("ddd MMM d, h:mm tt") : promise.DueText;
            Model.Sources.TryGetValue(promise.SourceEventId, out var source);
            Model.SourceTraces.TryGetValue(promise.SourceEventId, out var trace);
            var (stateKey, stateLabel) = promise.State switch
            {
                HomeNode.Data.PromiseState.Made => ("waiting", "Open"),
                HomeNode.Data.PromiseState.Kept => ("done", "Done"),
                HomeNode.Data.PromiseState.Broken => ("stopped", "Closed, not done"),
                HomeNode.Data.PromiseState.Released => ("stopped", "No longer needed"),
                _ => ("recorded", promise.State.ToString())
            };
            <article class="claim@(promise.State == HomeNode.Data.PromiseState.Made ? " claim--open" : "")">
                <header class="claim-head">
                    <span class="avatar avatar--@PersonStyle.Slot(promise.PromisorPersonId)" aria-hidden="true">@PersonStyle.Initial(maker)</span>
                    <div class="trace-head-text">
                        <span class="trace-who">@maker took it on</span>
                        <span class="trace-sub">For @forWhom@(due is null ? "" : $" · due {due}")</span>
                    </div>
                    <span class="status status--@stateKey">@stateLabel</span>
                </header>
                <p class="claim-text">&ldquo;@promise.CommitmentText&rdquo;</p>
                <ol class="chain">
                    @if (source is not null)
                    {
                        <li class="chain--person">
                            <span class="chain-icon">@Icons.Get("person", 12)</span>
                            <span>@maker said: &ldquo;@source.Body&rdquo; <span class="chain-when">&middot; @HouseholdTime.TimeOrDate(source.CreatedAtUtc, Model.HouseholdZone)@(trace is not null ? $" · {trace.ChannelLabel}" : "")</span></span>
                        </li>
                        <li class="chain--@(trace?.Engine.Kind is "live" or "mock" ? "model" : "house")">
                            <span class="chain-icon">@Icons.Get(trace?.Engine.Kind is "live" or "mock" ? "spark" : trace?.Engine.Kind == "seed" ? "seed" : "shield", 12)</span>
                            <span>@EngineSentence(trace)@if (trace is not null) {<text> &middot; <a href="@(timelineHref)#@trace.Key">see the trace</a></text>}</span>
                        </li>
                        @if (trace?.Entries.FirstOrDefault(e => e.Event.Id == promise.SourceEventId) is { } sourceEntry)
                        {
                            <li class="chain--house">
                                <span class="chain-icon">@Icons.Get("shield", 12)</span>
                                <span>Who can see it: <strong>@sourceEntry.AudienceLabel</strong></span>
                            </li>
                        }
                    }
                    @switch (promise.State)
                    {
                        case HomeNode.Data.PromiseState.Made:
                            <li class="chain--person">
                                <span class="chain-icon">@Icons.Get("clock", 12)</span>
                                <span>Open until a person closes it in their own words.</span>
                            </li>
                            break;
                        default:
                            <li class="chain--person">
                                <span class="chain-icon">@Icons.Get(promise.State == HomeNode.Data.PromiseState.Kept ? "check" : "stop", 12)</span>
                                <span>@NameWording.First(promise.ClosedByPerson?.DisplayName) closed it as @stateLabel.ToLowerInvariant()@if (promise.ClosedByEvent?.Body is { } closingWords) {<text>: &ldquo;@closingWords&rdquo;</text>}<span class="chain-when">@(promise.ClosedAtUtc is { } closedAt ? " · " + HouseholdTime.TimeOrDate(closedAt, Model.HouseholdZone) : "")</span></span>
                            </li>
                            break;
                    }
                </ol>
                @if (promise.State == HomeNode.Data.PromiseState.Made)
                {
                    <details class="disclose" style="margin:0.85rem 0 0">
                        <summary>Close this claim <span class="muted">In the closer's own words</span></summary>
                        <div class="disclose-body">
                            <form method="post" asp-page-handler="Close" class="claim-close-form form-row" data-promisor="@promise.PromisorPersonId" data-promisee="@(promise.PromiseePersonId?.ToString() ?? "")">
                                <input type="hidden" name="promiseId" value="@promise.Id" />
                                <label>
                                    Closed by
                                    <select name="closerPersonId">
                                        @if (Model.ViewerId is null)
                                        {
                                            <option value="" selected>Choose who closed it</option>
                                        }
                                        @foreach (var person in Model.People)
                                        {
                                            if (Model.ViewerId == person.Id)
                                            {
                                                <option value="@person.Id" selected>@NameWording.First(person.DisplayName)</option>
                                            }
                                            else
                                            {
                                                <option value="@person.Id">@NameWording.First(person.DisplayName)</option>
                                            }
                                        }
                                    </select>
                                </label>
                                <label>
                                    Outcome
                                    <select name="outcome">
                                        <option value="Kept">Done</option>
                                        <option value="Broken">Not done</option>
                                        <option value="Released">No longer needed</option>
                                    </select>
                                </label>
                                <label style="flex:1 1 16rem">
                                    In their words
                                    <input type="text" name="closingWords" style="width:100%" placeholder="e.g., &quot;Home, like I said this morning.&quot;" />
                                </label>
                                <button type="submit" class="primary">Close claim</button>
                            </form>
                        </div>
                    </details>
                }
            </article>
        }
    </div>
}

@section Scripts {
    <script>
        // Released is offered only when it can apply to the closer
        // chosen in the same form: the person the claim was for, or
        // the person who took it on when the claim was for the
        // house. The server enforces the same rule on submit; this
        // only keeps the form honest.
        document.querySelectorAll('form[data-promisor]').forEach(function (form) {
            var closer = form.querySelector('select[name="closerPersonId"]');
            var outcome = form.querySelector('select[name="outcome"]');
            if (!closer || !outcome) { return; }
            var released = outcome.querySelector('option[value="Released"]');
            function updateReleased() {
                var promisee = form.getAttribute('data-promisee');
                var allowed = promisee
                    ? closer.value === promisee
                    : closer.value === form.getAttribute('data-promisor');
                released.disabled = !allowed;
                if (!allowed && outcome.value === 'Released') {
                    outcome.value = 'Kept';
                }
            }
            closer.addEventListener('change', updateReleased);
            updateReleased();
        });
    </script>
}
