@page "/Promises"
@model HomeNode.Pages.PromisesModel
@{
    ViewData["Title"] = "My Claims";
}

<h1>My Claims</h1>
<p>What people in the household have said they'll do, in their own words.</p>

@if (Model.Note is not null)
{
    <p>@Model.Note</p>
}

<form method="get">
    <label>
        Viewing as
        <select name="ViewerId" onchange="this.form.submit()">
            <option value="">Household view</option>
            @foreach (var person in Model.People)
            {
                if (Model.ViewerId == person.Id)
                {
                    <option value="@person.Id" selected>@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
                else
                {
                    <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                }
            }
        </select>
    </label>
</form>
@if (Model.Promises.Count == 0)
{
    <p>No claims yet. When someone says &ldquo;I'll&hellip;&rdquo;, it shows up here.</p>
}
else
{
    <div class="panel panel-table claims-panel">
    <table class="table claims-table">
        <thead>
            <tr>
                <th>Claim</th>
                <th>By</th>
                <th>For</th>
                <th>Due</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var promise in Model.Promises)
            {
                <tr>
                    <td>@promise.CommitmentText</td>
                    <td>@HomeNode.Data.NameWording.First(promise.PromisorPerson?.DisplayName)</td>
                    <td>@(promise.PromiseePerson is null ? "Household" : HomeNode.Data.NameWording.First(promise.PromiseePerson.DisplayName))</td>
                    <td>@(promise.DueAtLocal is { } dueAt ? dueAt.ToString("MMM d, h:mm tt") : promise.DueText ?? "")</td>
                    <td>
                        @switch (promise.State)
                        {
                            case HomeNode.Data.PromiseState.Made:
                                <text>Open</text>
                                break;
                            case HomeNode.Data.PromiseState.Kept:
                                <text>Done &middot; &ldquo;@(promise.ClosedByEvent?.Body ?? "")&rdquo; &middot; @HomeNode.Data.NameWording.First(promise.ClosedByPerson?.DisplayName), @(promise.ClosedAtUtc is { } keptAt ? HomeNode.Data.HouseholdTime.Time(keptAt, Model.HouseholdZone) : "")</text>
                                break;
                            case HomeNode.Data.PromiseState.Broken:
                                <text>Closed &middot; still unclaimed &middot; @HomeNode.Data.NameWording.First(promise.ClosedByPerson?.DisplayName), @(promise.ClosedAtUtc is { } brokenAt ? HomeNode.Data.HouseholdTime.Time(brokenAt, Model.HouseholdZone) : "")</text>
                                if (promise.ClosedByEvent?.Body is { } brokenWords)
                                {
                                    <br /><text>In their words: &ldquo;@brokenWords&rdquo;</text>
                                }
                                break;
                            case HomeNode.Data.PromiseState.Released:
                                <text>Released &middot; @HomeNode.Data.NameWording.First(promise.ClosedByPerson?.DisplayName), @(promise.ClosedAtUtc is { } releasedAt ? HomeNode.Data.HouseholdTime.Time(releasedAt, Model.HouseholdZone) : "")</text>
                                if (promise.ClosedByEvent?.Body is { } releasedWords)
                                {
                                    <br /><text>In their words: &ldquo;@releasedWords&rdquo;</text>
                                }
                                break;
                        }
                    </td>
                    <td>
                        @if (promise.State == HomeNode.Data.PromiseState.Made)
                        {
                            <form method="post" asp-page-handler="Close" class="claim-close-form" data-promisor="@promise.PromisorPersonId" data-promisee="@(promise.PromiseePersonId?.ToString() ?? "")">
                                <input type="hidden" name="promiseId" value="@promise.Id" />
                                <label>
                                    Closed by
                                    <select name="closerPersonId">
                                        @foreach (var person in Model.People)
                                        {
                                            <option value="@person.Id">@HomeNode.Data.NameWording.First(person.DisplayName)</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    Outcome
                                    <select name="outcome">
                                        <option value="Kept">Done</option>
                                        <option value="Broken">Still unclaimed</option>
                                        <option value="Released">Released</option>
                                    </select>
                                </label>
                                <label>
                                    In their words
                                    <input type="text" name="closingWords" placeholder="e.g., &quot;Home, like I said this morning.&quot;" />
                                </label>
                                <button type="submit">Close claim</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@section Scripts {
    <script>
        // Released is offered only when it can apply to the closer
        // chosen in the same form: the person the claim was for, or
        // the person who took it on when the claim was for the
        // house. The server enforces the same rule on submit; this
        // only keeps the form honest.
        document.querySelectorAll('form[data-promisor]').forEach(function (form) {
            var closer = form.querySelector('select[name="closerPersonId"]');
            var outcome = form.querySelector('select[name="outcome"]');
            if (!closer || !outcome) { return; }
            var released = outcome.querySelector('option[value="Released"]');
            function updateReleased() {
                var promisee = form.getAttribute('data-promisee');
                var allowed = promisee
                    ? closer.value === promisee
                    : closer.value === form.getAttribute('data-promisor');
                released.disabled = !allowed;
                if (!allowed && outcome.value === 'Released') {
                    outcome.value = 'Kept';
                }
            }
            closer.addEventListener('change', updateReleased);
            updateReleased();
        });
    </script>
}
