@page "/Promises"
@model HouseholdCoordinator.Pages.PromisesModel
@{
    ViewData["Title"] = "My Claims";
}

<h1>My Claims</h1>
<p>Things a person has taken on themselves, in their own words, kept
   as a record in its own right. Nobody is handed a claim: a person
   takes it on themselves. A claim is settled only when a person
   says so, in words that join the record.</p>

@if (Model.Note is not null)
{
    <p><strong>@Model.Note</strong></p>
}

<form method="get">
    <label>
        Reading as
        <select name="ViewerId" onchange="this.form.submit()">
            <option value="">No reader named (house entries only)</option>
            @foreach (var person in Model.People)
            {
                if (Model.ViewerId == person.Id)
                {
                    <option value="@person.Id" selected>@person.DisplayName</option>
                }
                else
                {
                    <option value="@person.Id">@person.DisplayName</option>
                }
            }
        </select>
    </label>
</form>
<p>Claims are listed only for the reader named here, and only the
   ones that reader is meant to see, as set when each claim was
   recorded.</p>

@if (Model.Promises.Count == 0)
{
    <p>No claims on the record yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Claimed by</th>
                <th>Claim</th>
                <th>For whom</th>
                <th>Due</th>
                <th>Status</th>
                <th>Settle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var promise in Model.Promises)
            {
                <tr>
                    <td>@(promise.PromisorPerson?.DisplayName ?? "")</td>
                    <td>@promise.CommitmentText</td>
                    <td>@(promise.PromiseePerson?.DisplayName ?? "The house")</td>
                    <td>@(promise.DueText ?? "")</td>
                    <td>
                        @switch (promise.State)
                        {
                            case HouseholdCoordinator.Data.PromiseState.Made:
                                <text>Still open</text>
                                break;
                            case HouseholdCoordinator.Data.PromiseState.Kept:
                                <text>Done, closed by @(promise.ClosedByPerson?.DisplayName ?? "")</text>
                                break;
                            case HouseholdCoordinator.Data.PromiseState.Broken:
                                <text>Still unclaimed, closed by @(promise.ClosedByPerson?.DisplayName ?? "")</text>
                                break;
                            case HouseholdCoordinator.Data.PromiseState.Released:
                                <text>Released by @(promise.ClosedByPerson?.DisplayName ?? "")</text>
                                break;
                        }
                    </td>
                    <td>
                        @if (promise.State == HouseholdCoordinator.Data.PromiseState.Made)
                        {
                            <form method="post" asp-page-handler="Close">
                                <input type="hidden" name="promiseId" value="@promise.Id" />
                                <label>
                                    Settled by
                                    <select name="closerPersonId">
                                        @foreach (var person in Model.People)
                                        {
                                            <option value="@person.Id">@person.DisplayName</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    Outcome
                                    <select name="outcome">
                                        <option value="Kept">Done</option>
                                        <option value="Broken">Still unclaimed</option>
                                        <option value="Released">Released</option>
                                    </select>
                                </label>
                                <label>
                                    The closing words
                                    <input type="text" name="closingWords" placeholder="What the person said" />
                                </label>
                                <button type="submit">Settle this claim</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
